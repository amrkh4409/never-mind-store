{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="container announcement-bar__content">
      {%- assign is_ar = false -%}
      {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
        {%- assign is_ar = true -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign a_text = block.settings.text -%}
        {%- if is_ar -%}
          {%- if a_text contains 'FREE SHIPPING' or a_text contains 'Free Shipping' or a_text contains 'CASH ON DELIVERY' -%}
            {%- assign a_text = 'شحن مجاني لجميع محافظات مصر للطلبات فوق 1000 ج.م • الدفع عند الاستلام متاح' -%}
          {%- endif -%}
        {%- endif -%}
        <div class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" style="color: inherit;">
              {{ a_text }}
            </a>
          {%- else -%}
            <span>{{ a_text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "FREE SHIPPING ACROSS EGYPT OVER 1000 EGP • CASH ON DELIVERY AVAILABLE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "FREE SHIPPING ON ORDERS OVER 1000 EGP • CASH ON DELIVERY AVAILABLE • INSPECT PACKAGE BEFORE PAYMENT"
        }
      }
    ]
  }
}
{% endschema %}
