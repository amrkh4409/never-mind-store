{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="container announcement-bar__content">
      {%- assign is_ar = false -%}
      {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
        {%- assign is_ar = true -%}
      {%- endif -%}
      {%- assign has_free_shipping = false -%}
      {%- if settings.enable_free_shipping == true and settings.free_shipping_threshold > 0 -%}
        {%- assign has_free_shipping = true -%}
        {%- assign fs_cents = settings.free_shipping_threshold | times: 100 -%}
        {%- assign fs_money = fs_cents | money -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign a_text = block.settings.text -%}
        {%- if has_free_shipping -%}
          {%- if is_ar -%}
            {%- if a_text contains 'FREE SHIPPING' or a_text contains 'Free Shipping' or a_text contains 'شحن مجاني' or a_text contains '1000' -%}
              {%- assign a_text = 'شحن مجاني لجميع محافظات مصر للطلبات فوق ' | append: fs_money | append: ' • الدفع عند الاستلام متاح' -%}
            {%- endif -%}
          {%- else -%}
            {%- if a_text contains '1000 EGP' or a_text contains '1000' -%}
              {%- assign a_text = a_text | replace: '1000 EGP', fs_money | replace: '1000', fs_money -%}
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          {%- if is_ar -%}
            {%- if a_text contains 'FREE SHIPPING' or a_text contains 'Free Shipping' or a_text contains 'شحن مجاني' -%}
              {%- assign a_text = 'الدفع عند الاستلام متاح • فحص ومعاينة الشحنة قبل الدفع' -%}
            {%- endif -%}
          {%- else -%}
            {%- if a_text contains 'FREE SHIPPING' or a_text contains 'Free Shipping' or a_text contains 'Free shipping' -%}
              {%- assign a_text = a_text | replace: 'FREE SHIPPING ON ORDERS OVER 1000 EGP • ', '' | replace: 'FREE SHIPPING ACROSS EGYPT OVER 1000 EGP • ', '' | replace: 'FREE SHIPPING • ', '' | replace: 'Free Shipping • ', '' -%}
              {%- if a_text contains 'FREE SHIPPING' or a_text contains 'Free Shipping' -%}
                {%- assign a_text = 'CASH ON DELIVERY AVAILABLE • INSPECT PACKAGE BEFORE PAYMENT' -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        <div class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" style="color: inherit;">
              {{ a_text }}
            </a>
          {%- else -%}
            <span>{{ a_text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "CASH ON DELIVERY AVAILABLE • INSPECT PACKAGE BEFORE PAYMENT"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "CASH ON DELIVERY AVAILABLE • INSPECT PACKAGE BEFORE PAYMENT"
        }
      }
    ]
  }
}
{% endschema %}
