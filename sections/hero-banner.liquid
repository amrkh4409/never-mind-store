<!-- TEST HERO COMMIT 2026-09-18-01 -->
<div class="hero-banner" style="min-height: {{ section.settings.banner_height }}vh;">
  {%- if section.settings.image_desktop != blank -%}
    <img
      src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="hero-banner__media"
      loading="eager"
      width="2000"
      height="1100"
    >
  {%- endif -%}

  <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  {%- assign is_ar = false -%}
  {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
    {%- assign is_ar = true -%}
  {%- endif -%}

  {%- assign h_subheading = section.settings.subheading -%}
  {%- assign h_heading = section.settings.heading -%}
  {%- assign h_text = section.settings.text -%}
  {%- assign h_btn1 = section.settings.button_1_label -%}
  {%- assign h_btn2 = section.settings.button_2_label -%}

  {%- if is_ar -%}
    {%- if h_subheading == 'NEW LUXURY STREETWEAR COLLECTION' or h_subheading contains 'STREETWEAR COLLECTION' -%}
      {%- assign h_subheading = 'تشكيلة أزياء ستريت وير فاخرة جديدة' -%}
    {%- endif -%}
    {%- if h_heading == 'Minimal Aesthetics. Uncompromising Craft.' or h_heading contains 'Minimal Aesthetics' -%}
      {%- assign h_heading = 'جماليات مينيمال. حرفية مصرية بلا مساومة.' -%}
    {%- endif -%}
    {%- if h_text == 'Engineered for comfort, precision, and timeless presence in Egypt.' or h_text contains 'Engineered for comfort' -%}
      {%- assign h_text = 'مصممة بأعلى معايير الراحة والدقة والحضور المميز في مصر.' -%}
    {%- endif -%}
    {%- if h_btn1 == 'SHOP MEN' or h_btn1 == 'Shop Men' -%}
      {%- assign h_btn1 = 'تسوق رجالي' -%}
    {%- endif -%}
    {%- if h_btn2 == 'SHOP WOMEN' or h_btn2 == 'Shop Women' -%}
      {%- assign h_btn2 = 'تسوق حريمي' -%}
    {%- endif -%}
  {%- endif -%}

  <div class="container hero-banner__content" style="text-align: {{ section.settings.text_alignment }}; margin-{{ section.settings.text_alignment }}: 0;">
    {%- if h_subheading != blank -%}
      <div class="hero-banner__subheading">{{ h_subheading }}</div>
    {%- endif -%}

    <h1 class="hero-banner__heading">{{ h_heading }}</h1>

    {%- if h_text != blank -%}
      <p class="hero-banner__text">{{ h_text }}</p>
    {%- endif -%}

    <div class="hero-banner__actions" style="justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};">
      {%- if h_btn1 != blank -%}
        <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="btn btn-white btn-lg">
          {{ h_btn1 }}
        </a>
      {%- endif -%}

      {%- if h_btn2 != blank -%}
        <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="btn btn-secondary btn-lg" style="color: #FFFFFF; border-color: #FFFFFF;">
          {{ h_btn2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Banner Height",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Darkness",
      "default": 35
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "NEW LUXURY STREETWEAR COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Minimal Aesthetics. Uncompromising Craft."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Engineered for comfort, precision, and timeless presence in Egypt. Cash on delivery available nationwide."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "SHOP MEN"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "SHOP WOMEN"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
