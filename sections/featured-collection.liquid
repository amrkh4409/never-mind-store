<section class="featured-products-section" style="padding: 60px 0;">
  <div class="container">
    {%- assign is_ar = false -%}
    {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
      {%- assign is_ar = true -%}
    {%- endif -%}

    {%- assign display_title = section.settings.title | default: "Best Sellers" -%}
    {%- assign display_subtitle = section.settings.subtitle -%}
    {%- assign display_view_all = section.settings.view_all_text | default: "View All" -%}

    {%- if is_ar -%}
      {%- if section.settings.title == 'Best Sellers' or section.settings.title == 'Featured Best Sellers' or section.settings.title == blank -%}
        {%- assign display_title = 'الأكثر مبيعاً' -%}
        {%- assign display_subtitle = 'القطع الأكثر طلباً ورواجاً الآن' -%}
        {%- assign display_view_all = 'عرض الأكثر مبيعاً' -%}
      {%- elsif section.settings.title == "Men Collection" or section.settings.title == "Men's Collection" or section.settings.title == "MEN" -%}
        {%- assign display_title = 'تشكيلة الرجال' -%}
        {%- assign display_subtitle = 'تيشيرتات أوفر سايز فاخرة وهوديز وبناطيل كارغو' -%}
        {%- assign display_view_all = 'تسوق تشكيلة الرجال' -%}
      {%- elsif section.settings.title == "Women Collection" or section.settings.title == "Women's Collection" or section.settings.title == "WOMEN" -%}
        {%- assign display_title = 'تشكيلة النساء' -%}
        {%- assign display_subtitle = 'تصاميم عصرية مريحة مصممة من أجود أقطان مصر' -%}
        {%- assign display_view_all = 'تسوق تشكيلة النساء' -%}
      {%- elsif section.settings.title == "Kids Collection" or section.settings.title == "Kids & Teens Collection" or section.settings.title == "Kids & Teens" or section.settings.title == "KIDS & TEENS" -%}
        {%- assign display_title = 'تشكيلة الأطفال والناشئين' -%}
        {%- assign display_subtitle = 'قطع مريحة وعملية لحرية الحركة والراحة التامة' -%}
        {%- assign display_view_all = 'تسوق تشكيلة الأطفال' -%}
      {%- else -%}
        {%- assign display_title = section.settings.title -%}
        {%- if display_view_all == 'View All' -%}
          {%- assign display_view_all = 'عرض الكل' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    <div class="section-header">
      <div>
        <h2 class="section-header__title">{{ display_title }}</h2>
        {%- if display_subtitle != blank -%}
          <p class="section-header__subtitle">{{ display_subtitle }}</p>
        {%- endif -%}
      </div>

      <div style="display: flex; align-items: center; gap: 16px;">
        {%- if section.settings.enable_slider -%}
          <!-- Slider Navigation Arrows -->
          <div class="slider-arrows" style="display: flex; align-items: center; gap: 8px;">
            <button
              type="button"
              class="slider-arrow-btn slider-arrow-btn--prev"
              data-slider-prev="{{ section.id }}"
              aria-label="{{ 'general.pagination.previous' | t }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="slider-arrow-btn slider-arrow-btn--next"
              data-slider-next="{{ section.id }}"
              aria-label="{{ 'general.pagination.next' | t }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}

        {%- assign collection = collections[section.settings.collection] -%}
        {%- assign target_url = section.settings.view_all_link | default: collection.url | default: routes.all_products_collection_url -%}
        <a href="{{ target_url }}" class="section-header__link">
          <span>{{ display_view_all }}</span>
          {% render 'icon-chevron' %}
        </a>
      </div>
    </div>

    {%- if section.settings.enable_slider -%}
      <!-- Slider Carousel View (Up to 12 Products) -->
      <div
        id="Slider-{{ section.id }}"
        class="products-slider"
        data-products-slider
        style="--slider-cols-desktop: {{ section.settings.columns_desktop }};"
      >
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="products-slider__item">
              {% render 'product-card', product_card_product: product, show_vendor: section.settings.show_vendor %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            <div class="products-slider__item">
              <div class="product-card">
                <div class="product-card__media-wrapper">
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__img' }}
                  <div class="product-card__badges">
                    <span class="badge badge-sale">-20%</span>
                  </div>
                </div>
                <div class="product-card__content">
                  <span class="product-card__vendor">Never Mind</span>
                  <h3 class="product-card__title">
                    {%- if is_ar -%}
                      تيشيرت ستريت وير فاخر {{ i }}
                    {%- else -%}
                      Luxury Streetwear Tee {{ i }}
                    {%- endif -%}
                  </h3>
                  <div class="product-card__price-wrap">
                    <span class="product-price">599 EGP</span>
                    <s class="product-price product-price--compare">749 EGP</s>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <!-- Standard Grid View -->
      <div class="products-grid" style="--grid-desktop-cols: {{ section.settings.columns_desktop | default: 4 }};">
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {% render 'product-card', product_card_product: product, show_vendor: section.settings.show_vendor %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            <div class="product-card">
              <div class="product-card__media-wrapper">
                {{ 'product-1' | placeholder_svg_tag: 'product-card__img' }}
              </div>
              <div class="product-card__content">
                <span class="product-card__vendor">Never Mind</span>
                <h3 class="product-card__title">
                  {%- if is_ar -%}
                    قطعة ستريت وير أساسية {{ i }}
                  {%- else -%}
                    Luxury Heavyweight Essential {{ i }}
                  {%- endif -%}
                </h3>
                <div class="product-card__price-wrap">
                  <span class="product-price">650 EGP</span>
                  <s class="product-price product-price--compare">850 EGP</s>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Our most wanted pieces right now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Products to Show (Max 12)",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable Horizontal Slider",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns per View on Desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand / Vendor",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Custom View All Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Products Slider"
    }
  ]
}
{% endschema %}
