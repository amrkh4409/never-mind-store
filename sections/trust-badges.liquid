<section class="trust-section">
  <div class="container">
    <div class="trust-grid">
      {%- assign is_ar = false -%}
      {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
        {%- assign is_ar = true -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign t_title = block.settings.title -%}
        {%- assign t_text = block.settings.text -%}

        {%- if is_ar -%}
          {%- case block.type -%}
            {%- when 'cod' -%}
              {%- if t_title == 'Cash on Delivery' -%}{%- assign t_title = 'الدفع عند الاستلام' -%}{%- endif -%}
              {%- if t_text contains 'Pay comfortably' -%}{%- assign t_text = 'ادفع بأمان وراحة عند استلام طلبك حتى باب منزلك' -%}{%- endif -%}
            {%- when 'inspection' -%}
              {%- if t_title contains 'Inspect' -%}{%- assign t_title = 'معاينة وفحص الطلب قبل الدفع' -%}{%- endif -%}
              {%- if t_text contains 'Open and review' -%}{%- assign t_text = 'افتح الشحنة وتأكد من جودة ومقاسات المنتجات بحضور المندوب قبل السداد' -%}{%- endif -%}
            {%- when 'shipping' -%}
              {%- if t_title contains 'Shipping' or t_title contains 'Delivery' -%}{%- assign t_title = 'شحن سريع لجميع محافظات مصر' -%}{%- endif -%}
              {%- if t_text contains 'Cairo' or t_text contains '24-48' -%}{%- assign t_text = 'القاهرة والجيزة خلال ٢٤-٤٨ ساعة | باقي المحافظات خلال ٢-٤ أيام عمل' -%}{%- endif -%}
            {%- when 'exchange' -%}
              {%- if t_title contains 'Exchange' -%}{%- assign t_title = 'استبدال مقاسات خلال 14 يوماً' -%}{%- endif -%}
              {%- if t_text contains 'WhatsApp' or t_text contains 'replacement' -%}{%- assign t_text = 'استبدال سهل وسريع للمقاسات وخدمة عملاء مباشرة عبر واتساب' -%}{%- endif -%}
          {%- endcase -%}
        {%- endif -%}

        <div class="trust-item" {{ block.shopify_attributes }}>
          <div class="trust-item__icon">
            {%- case block.type -%}
              {%- when 'shipping' -%}
                {% render 'icon-truck' %}
              {%- when 'inspection' -%}
                {% render 'icon-shield' %}
              {%- when 'cod' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>
              {%- when 'exchange' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
              {%- else -%}
                {% render 'icon-shield' %}
            {%- endcase -%}
          </div>
          <div>
            <h4 class="trust-item__title">{{ t_title }}</h4>
            <p class="trust-item__text">{{ t_text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [],
  "blocks": [
    {
      "type": "cod",
      "name": "Cash on Delivery",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cash on Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Pay comfortably upon receiving your order at your doorstep"
        }
      ]
    },
    {
      "type": "inspection",
      "name": "Inspect Before Paying",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Inspect Before Payment"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Open and review your package with the courier before paying"
        }
      ]
    },
    {
      "type": "shipping",
      "name": "Fast Delivery",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Shipping Across Egypt"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Cairo & Giza 24-48 hours | All governorates 2-4 business days"
        }
      ]
    },
    {
      "type": "exchange",
      "name": "Easy Exchange",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "14-Day Size Exchange"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Effortless size replacement and customer care via WhatsApp"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "cod" },
        { "type": "inspection" },
        { "type": "shipping" },
        { "type": "exchange" }
      ]
    }
  ]
}
{% endschema %}
