<section class="trust-section">
  <div class="container">
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          <div class="trust-item__icon">
            {%- case block.type -%}
              {%- when 'shipping' -%}
                {% render 'icon-truck' %}
              {%- when 'inspection' -%}
                {% render 'icon-shield' %}
              {%- when 'cod' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>
              {%- when 'exchange' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
              {%- else -%}
                {% render 'icon-shield' %}
            {%- endcase -%}
          </div>
          <div>
            <h4 class="trust-item__title">{{ block.settings.title }}</h4>
            <p class="trust-item__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [],
  "blocks": [
    {
      "type": "cod",
      "name": "Cash on Delivery",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cash on Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Pay comfortably upon receiving your order at your doorstep"
        }
      ]
    },
    {
      "type": "inspection",
      "name": "Inspect Before Paying",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Inspect Before Payment"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Open and review your package with the courier before paying"
        }
      ]
    },
    {
      "type": "shipping",
      "name": "Fast Delivery",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Shipping Across Egypt"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Cairo & Giza 24-48 hours | All governorates 2-4 business days"
        }
      ]
    },
    {
      "type": "exchange",
      "name": "Easy Exchange",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "14-Day Size Exchange"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Effortless size replacement and customer care via WhatsApp"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "cod" },
        { "type": "inspection" },
        { "type": "shipping" },
        { "type": "exchange" }
      ]
    }
  ]
}
{% endschema %}
