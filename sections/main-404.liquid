<div class="container" style="padding: 100px 16px; text-align: center; max-width: 600px;">
  <span style="font-size: 5rem; font-weight: 800; font-family: var(--font-heading); color: var(--color-foreground-muted); line-height: 1;">404</span>
  <h1 style="margin: 16px 0;">{{ 'general.404.title' | t }}</h1>
  <p style="color: var(--color-foreground-secondary); font-size: 1.05rem; margin-bottom: 32px;">
    {{ 'general.404.subtext' | t }}
  </p>
  <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">{{ 'general.404.link' | t }}</a>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
