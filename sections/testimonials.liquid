<section class="testimonials-section" style="padding: 72px 0; background-color: var(--color-bg-secondary); border-top: 1px solid var(--color-border-light); border-bottom: 1px solid var(--color-border-light);">
  <div class="container">
    {%- assign is_ar = false -%}
    {%- if request.locale.iso_code == 'ar' -%}
      {%- assign is_ar = true -%}
    {%- endif -%}

    {%- assign display_heading = section.settings.heading | default: "What Our Customers Say" -%}
    {%- assign display_subheading = section.settings.subheading -%}

    {%- if is_ar -%}
      {%- if section.settings.heading == 'What Our Customers Say' or section.settings.heading == blank -%}
        {%- assign display_heading = 'ماذا يقول عملاؤنا' -%}
      {%- endif -%}
      {%- if section.settings.subheading == 'Real reviews from our community across Egyptian governorates' or section.settings.subheading == blank -%}
        {%- assign display_subheading = 'آراء وتقييمات حقيقية من عملائنا في جميع محافظات مصر' -%}
      {%- endif -%}
    {%- endif -%}

    <div class="section-header" style="margin-bottom: 48px; text-align: center; justify-content: center; flex-direction: column;">
      <h2 class="section-header__title" style="font-size: 2rem;">{{ display_heading }}</h2>
      {%- if display_subheading != blank -%}
        <p class="section-header__subtitle" style="max-width: 600px; margin: 0 auto; font-size: 1rem;">
          {{ display_subheading }}
        </p>
      {%- endif -%}
    </div>

    <!-- Testimonials Grid -->
    <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
      {%- for block in section.blocks -%}
        {%- assign card_title = block.settings.title -%}
        {%- assign card_text = block.settings.text -%}
        {%- assign card_author = block.settings.author -%}
        {%- assign card_location = block.settings.location -%}

        {%- if is_ar -%}
          {%- if card_title == 'Best Egyptian cotton streetwear' -%}
            {%- assign card_title = 'أفضل ستريت وير قطن مصري' -%}
            {%- assign card_text = 'المقاس الأوفر سايز مظبوط جداً ووزن القماش فاخر ومحمل. المعاينة قبل الدفع إدتني ثقة وأمان في الشراء.' -%}
            {%- assign card_author = 'يوسف م.' -%}
            {%- assign card_location = 'القاهرة الجديدة، التجمع' -%}
          {%- elsif card_title == 'Delivered in 24 hours to Alex!' -%}
            {%- assign card_title = 'توصيل في 24 ساعة للإسكندرية!' -%}
            {%- assign card_text = 'شحن فائق السرعة لرشدي بالإسكندرية وتغليف فخم جداً. بالتأكيد سأطلب مجدداً من التشكيلة القادمة.' -%}
            {%- assign card_author = 'مريم ح.' -%}
            {%- assign card_location = 'رشدي، الإسكندرية' -%}
          {%- elsif card_title == 'Easy size exchange via WhatsApp' -%}
            {%- assign card_title = 'استبدال مقاس فوري عبر الواتساب' -%}
            {%- assign card_text = 'كنت بحاجة لاستبدال المقاس، فريق خدمة العملاء على الواتساب تواصل معي فوراً وبدل المندوب المقاس عند باب المنزل.' -%}
            {%- assign card_author = 'عمر ك.' -%}
            {%- assign card_location = 'الشيخ زايد، الجيزة' -%}
          {%- elsif card_title == 'Try on before paying is a game changer' -%}
            {%- assign card_title = 'المعاينة قبل الدفع ميزة استثنائية' -%}
            {%- assign card_text = 'فتحت الشحنة وتأكدت من المقاس والخامة مع المندوب قبل دفع أي مليم. براند مصري فخم بخدمة عملاء محترفة.' -%}
            {%- assign card_author = 'نور ع.' -%}
            {%- assign card_location = 'المنصورة، الدقهلية' -%}
          {%- endif -%}
        {%- endif -%}

        <div class="testimonial-card" style="background: var(--color-bg); padding: 28px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; justify-content: space-between; position: relative;" {{ block.shopify_attributes }}>
          <div>
            <!-- Star Rating -->
            <div class="testimonial-stars" style="display: flex; align-items: center; gap: 4px; margin-bottom: 14px; color: #EAB308;">
              {%- for i in (1..block.settings.rating) -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {%- endfor -%}
            </div>

            <!-- Review Title -->
            {%- if card_title != blank -%}
              <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; color: var(--color-foreground);">
                {{ card_title }}
              </h4>
            {%- endif -%}

            <!-- Review Content -->
            <p style="color: var(--color-foreground-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
              "{{ card_text }}"
            </p>
          </div>

          <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border-light); padding-top: 16px; margin-top: auto;">
            <div>
              <div style="font-weight: 700; font-size: 0.95rem; color: var(--color-foreground);">
                {{ card_author }}
              </div>
              <div style="font-size: 0.8rem; color: var(--color-foreground-muted); margin-top: 2px;">
                {{ card_location }}
              </div>
            </div>

            {%- if block.settings.verified -%}
              <span class="badge badge-success" style="font-size: 0.75rem; padding: 4px 8px; display: inline-flex; align-items: center; gap: 4px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {%- if is_ar -%}
                  مشترٍ موثق
                {%- else -%}
                  {{ 'sections.testimonials.verified_buyer' | default: 'Verified Buyer' }}
                {%- endif -%}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from our community across Egyptian governorates"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Customer Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Headline",
          "default": "Exceptional fabric and fit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "The Egyptian cotton quality is out of this world. The courier allowed me to inspect the package before paying in New Cairo. Highly recommended!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Youssef M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location / Governorate",
          "default": "New Cairo, Egypt"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Buyer Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
