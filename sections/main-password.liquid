<div class="container" style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px 16px;">
  <div style="margin-bottom: 28px;">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="height: 48px; object-fit: contain;">
    {%- else -%}
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 48px; object-fit: contain;">
    {%- endif -%}
  </div>

  <h1 style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 12px;">Opening Soon</h1>
  <p style="color: var(--color-foreground-secondary); font-size: 1.1rem; max-width: 500px; margin-bottom: 36px; line-height: 1.6;">
    {{ section.settings.subheading | default: "We are putting the final touches on Egypt's new luxury streetwear and minimalist fashion destination." }}
  </p>

  <!-- Newsletter Signup for Opening Soon -->
  <div style="max-width: 440px; width: 100%; margin-bottom: 40px;">
    {%- form 'customer', id: 'PasswordNewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}
        <p style="color: var(--color-success); font-weight: 600;">Thank you! We'll notify you when we drop.</p>
      {%- else -%}
        <div style="display: flex; gap: 8px;">
          <input
            type="email"
            name="contact[email]"
            placeholder="Enter your email for early access"
            required
            style="flex: 1; padding: 12px 14px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.95rem; background: var(--color-bg);"
          >
          <button type="submit" class="btn btn-primary btn-sm">Notify Me</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>

  <!-- Password Entry Modal / Accordion -->
  <details style="font-size: 0.9rem; color: var(--color-foreground-secondary); max-width: 380px; width: 100%;">
    <summary style="cursor: pointer; font-weight: 600; text-decoration: underline;">
      Enter store using password
    </summary>
    <div style="margin-top: 16px; background: var(--color-bg-secondary); padding: 16px; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
      {%- form 'storefront_password', id: 'StorefrontPasswordForm' -%}
        {%- if form.errors -%}
          <div style="color: var(--color-sale); margin-bottom: 10px; font-size: 0.85rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <div style="margin-bottom: 10px;">
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Store password"
            required
            style="width: 100%; padding: 10px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.9rem; background: var(--color-bg);"
          >
        </div>
        <button type="submit" class="btn btn-primary btn-full btn-sm">Enter Store</button>
      {%- endform -%}
    </div>
  </details>
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We are preparing Egypt's newest luxury fashion drops. Stay tuned."
    }
  ]
}
{% endschema %}
