<div class="container" style="padding-top: 48px; padding-bottom: 80px; max-width: 960px;">
  <h1 style="margin-bottom: 32px; text-align: center;">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div style="background-color: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px; margin-bottom: 32px;">
        {%- for item in cart.items -%}
          <div class="cart-item" style="padding: 16px 0; border-bottom: 1px solid var(--color-border-light);">
            <div class="cart-item__media">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="cart-item__img">
              {%- endif -%}
            </div>
            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title" style="font-size: 1.05rem;">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <span class="cart-item__variant">{{ item.variant.title }}</span>
              {%- endunless -%}
              <span style="font-weight: 700; margin-top: 4px;">{{ item.final_line_price | money }}</span>

              <div class="cart-item__bottom">
                <div class="quantity-stepper">
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="quantity-stepper__btn">-</a>
                  <input type="text" name="updates[]" value="{{ item.quantity }}" class="quantity-stepper__input" readonly>
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="quantity-stepper__btn">+</a>
                </div>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="cart-item__remove">
                  {{ 'cart.general.remove' | t }}
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}

        <!-- Cart Note -->
        <div style="margin-top: 24px;">
          <label for="CartSpecialInstructions" style="display: block; font-weight: 600; margin-bottom: 8px;">
            {{ 'cart.general.note' | t }}
          </label>
          <textarea
            name="note"
            id="CartSpecialInstructions"
            rows="3"
            style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.9rem;"
          >{{ cart.note }}</textarea>
        </div>
      </div>

      <!-- Subtotal & Checkout Action -->
      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 14px;">
        <div style="font-size: 1.35rem; font-weight: 700;">
          <span>{{ 'cart.general.subtotal' | t }}: </span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size: 0.88rem; color: var(--color-foreground-secondary);">
          {{ 'sections.cart_drawer.taxes_included_and_shipping_policy_html' | t }}
        </p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/collections/all" class="btn btn-outline btn-lg">
            {{ 'cart.general.continue_shopping' | t }}
          </a>
          <button type="submit" name="checkout" class="btn btn-primary btn-lg">
            {{ 'cart.general.checkout' | t }}
          </button>
        </div>
      </div>
    </form>
  {%- else -%}
    <div style="text-align: center; padding: 60px 16px;">
      <h3 style="margin-bottom: 12px;">{{ 'cart.general.empty' | t }}</h3>
      <p style="color: var(--color-foreground-secondary); margin-bottom: 24px;">{{ 'sections.cart_drawer.empty_subtext' | t }}</p>
      <a href="/collections/all" class="btn btn-primary btn-lg">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
