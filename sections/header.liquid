<header class="header-wrapper" id="site-header">
  <div class="container header">
    <!-- Mobile Hamburger Toggle -->
    <div class="header__left">
      <button
        type="button"
        class="header__mobile-toggle"
        data-mobile-menu-toggle
        aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}"
        aria-controls="MobileNavDrawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            width="{{ section.settings.logo_width }}"
          >
        {%- else -%}
          <img
            src="{{ 'logo.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            style="height: {{ section.settings.logo_width | divided_by: 3 | default: 42 }}px;"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Menu -->
    <nav class="header__nav" aria-label="Main Navigation">
      {%- assign nav_links = linklists[section.settings.menu].links -%}
      {%- assign trigger_name = section.settings.mega_menu_trigger | default: 'Catalog' | downcase | strip -%}

      {%- if nav_links.size > 0 -%}
        {%- for link in nav_links -%}
          {%- assign downcased_title = link.title | downcase | strip -%}
          
          {%- assign is_mega = false -%}
          {%- if section.settings.enable_mega_menu -%}
            {%- if trigger_name != blank and downcased_title == trigger_name -%}
              {%- assign is_mega = true -%}
            {%- elsif trigger_name == blank or trigger_name == 'catalog' -%}
              {%- if downcased_title contains 'catalog' or downcased_title contains 'shop' or downcased_title contains 'collection' or downcased_title contains 'متجر' or downcased_title contains 'منتجات' or downcased_title contains 'تشكيلات' -%}
                {%- assign is_mega = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}

          <!-- Check if any block explicitly targets this menu link -->
          {%- assign has_matching_blocks = false -%}
          {%- assign first_matched_block = nil -%}
          {%- for block in section.blocks -%}
            {%- assign b_trig = block.settings.menu_trigger | default: block.settings.trigger_title | default: 'Catalog' | downcase | strip -%}
            {%- if b_trig == downcased_title or b_trig == '' and downcased_title == 'catalog' -%}
              {%- assign has_matching_blocks = true -%}
              {%- if first_matched_block == nil -%}{%- assign first_matched_block = block -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_matching_blocks -%}
            {%- assign is_mega = true -%}
          {%- endif -%}

          {%- assign is_sale = false -%}
          {%- assign is_hot = false -%}
          {%- assign is_new = false -%}
          {%- if downcased_title contains 'sale' or downcased_title contains 'تخفيض' or downcased_title contains 'عروض' -%}
            {%- assign is_sale = true -%}
          {%- elsif downcased_title contains 'best' or downcased_title contains 'الأكثر' or downcased_title contains 'top' -%}
            {%- assign is_hot = true -%}
          {%- elsif downcased_title contains 'new' or downcased_title contains 'جديد' -%}
            {%- assign is_new = true -%}
          {%- endif -%}

          {%- assign has_dropdown = false -%}
          {%- if link.links.size > 0 and is_mega == false -%}
            {%- assign has_dropdown = true -%}
          {%- endif -%}

          <div class="header__menu-item {% if is_mega %}header__menu-item--has-mega{% elsif has_dropdown %}header__menu-item--has-dropdown{% endif %} {% if is_sale %}header__menu-item--sale{% endif %}" {% if first_matched_block != nil %}{{ first_matched_block.shopify_attributes }}{% endif %}>
            <a href="{{ link.url }}" class="header__menu-link" {% if is_mega or has_dropdown %}aria-expanded="false" aria-haspopup="true"{% endif %}>
              <span>{{ link.title }}</span>
              {%- if is_sale -%}
                <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
              {%- elsif is_hot -%}
                <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
              {%- elsif is_new -%}
                <span class="nav-badge nav-badge--new">{{ 'sections.header.new' | t | default: 'NEW' }}</span>
              {%- endif -%}
              {%- if is_mega or has_dropdown -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              {%- endif -%}
            </a>

            {%- if is_mega -%}
              <!-- Unified Modular Mega Menu Dropdown -->
              {% render 'mega-menu', link: link, section: section %}
            {%- elsif has_dropdown -%}
              <!-- Standard Dropdown -->
              <div class="header__dropdown">
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}" class="header__dropdown-link">{{ child_link.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <!-- Standalone Best Sellers & Sale if not in menu -->
        {%- assign has_bestsellers_in_menu = false -%}
        {%- assign has_sale_in_menu = false -%}
        {%- for link in nav_links -%}
          {%- assign dt = link.title | downcase -%}
          {%- if dt contains 'best' or dt contains 'الأكثر' -%}{%- assign has_bestsellers_in_menu = true -%}{%- endif -%}
          {%- if dt contains 'sale' or dt contains 'تخفيض' or dt contains 'عروض' -%}{%- assign has_sale_in_menu = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_best_sellers and has_bestsellers_in_menu == false -%}
          <div class="header__menu-item">
            <a href="/collections/best-sellers" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}BEST SELLERS{% endif %}</span>
              <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.show_sale and has_sale_in_menu == false -%}
          <div class="header__menu-item header__menu-item--sale">
            <a href="/collections/sale" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}تخفيضات{% else %}SALE{% endif %}</span>
              <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </nav>

    <!-- Header Actions (Search, Account, Wishlist, Cart) -->
    <div class="header__right">
      <!-- Language Switcher -->
      {% render 'localization-selector' %}

      <!-- Search Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-search-open
        aria-label="{{ 'sections.header.search' | t | default: 'Search' }}"
      >
        {% render 'icon-search' %}
      </button>

      <!-- Customer Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__icon-btn"
          aria-label="{{ 'sections.header.account' | t | default: 'Account' }}"
        >
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <!-- Wishlist Counter -->
      <button
        type="button"
        class="header__icon-btn"
        data-wishlist-open
        aria-label="{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}"
      >
        {% render 'icon-heart' %}
        <span class="header__wishlist-count" data-wishlist-count style="display: none;">0</span>
      </button>

      <!-- Cart Drawer Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-cart-open
        aria-label="{{ 'sections.header.cart' | t | default: 'Cart' }}"
      >
        {% render 'icon-cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop -->
<div id="MobileNavBackdrop" class="drawer-backdrop" data-mobile-menu-close></div>

<!-- Mobile Navigation Drawer (Synchronized with Main Mega Menu & Multi-Level Accordions) -->
<div id="MobileNavDrawer" class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">
  <div class="mobile-nav-drawer__header">
    <div class="header__logo">
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 36px;">
    </div>
    <button type="button" class="mobile-nav-drawer__close-btn" data-mobile-menu-close aria-label="Close menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="mobile-nav-drawer__body">
    <!-- Mobile Search Bar -->
    <div class="mobile-nav__search-box">
      <button
        type="button"
        class="btn btn-outline btn-full btn-sm"
        data-search-open
        style="justify-content: flex-start; gap: 10px; color: var(--color-foreground-secondary);"
      >
        {% render 'icon-search' %}
        <span>{{ 'general.search.placeholder' | t | default: 'Search collections...' }}</span>
      </button>
    </div>

    <!-- Mobile Navigation Links with Multi-Level Accordions -->
    <div class="mobile-nav__links">
      {%- assign nav_links = linklists[section.settings.menu].links -%}
      {%- assign trigger_name = section.settings.mega_menu_trigger | default: 'Catalog' | downcase | strip -%}
      {%- assign is_rtl = false -%}
      {%- if request.locale.iso_code == 'ar' -%}{%- assign is_rtl = true -%}{%- endif -%}

      {%- for link in nav_links -%}
        {%- assign downcased_title = link.title | downcase | strip -%}
        
        {%- assign is_mega = false -%}
        {%- if section.settings.enable_mega_menu -%}
          {%- if trigger_name != blank and downcased_title == trigger_name -%}
            {%- assign is_mega = true -%}
          {%- elsif trigger_name == blank or trigger_name == 'catalog' -%}
            {%- if downcased_title contains 'catalog' or downcased_title contains 'shop' or downcased_title contains 'collection' or downcased_title contains 'متجر' or downcased_title contains 'منتجات' or downcased_title contains 'تشكيلات' -%}
              {%- assign is_mega = true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        <!-- Check matching blocks for this link -->
        {%- assign matched_columns_count = 0 -%}
        {%- assign matched_promo_block = nil -%}
        {%- assign matched_full_block = nil -%}
        {%- assign first_matched_block = nil -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_column' -%}
            {%- assign b_trig = block.settings.menu_trigger | default: 'Catalog' | downcase | strip -%}
            {%- if b_trig == downcased_title or b_trig == '' and downcased_title == 'catalog' -%}
              {%- assign matched_columns_count = matched_columns_count | plus: 1 -%}
              {%- if first_matched_block == nil -%}{%- assign first_matched_block = block -%}{%- endif -%}
            {%- endif -%}
          {%- elsif block.type == 'featured_card' -%}
            {%- assign b_trig = block.settings.menu_trigger | default: 'Catalog' | downcase | strip -%}
            {%- if b_trig == downcased_title or b_trig == '' and downcased_title == 'catalog' -%}
              {%- if matched_promo_block == nil -%}{%- assign matched_promo_block = block -%}{%- endif -%}
              {%- if first_matched_block == nil -%}{%- assign first_matched_block = block -%}{%- endif -%}
            {%- endif -%}
          {%- elsif block.type == 'mega_menu' -%}
            {%- assign b_trig = block.settings.trigger_title | default: 'Catalog' | downcase | strip -%}
            {%- if b_trig == downcased_title or b_trig == '' and downcased_title == 'catalog' -%}
              {%- if matched_full_block == nil -%}{%- assign matched_full_block = block -%}{%- endif -%}
              {%- if first_matched_block == nil -%}{%- assign first_matched_block = block -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if matched_columns_count > 0 or matched_full_block != nil -%}
          {%- assign is_mega = true -%}
        {%- endif -%}

        {%- assign has_children = false -%}
        {%- if link.links.size > 0 -%}
          {%- assign has_children = true -%}
        {%- endif -%}

        {%- if is_mega -%}
          <!-- Mobile Mega Menu Accordion -->
          <div class="mobile-nav__item mobile-nav__item--accordion" {% if first_matched_block != nil %}{{ first_matched_block.shopify_attributes }}{% endif %}>
            <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
              <span class="mobile-nav__title-wrap">
                <span class="mobile-nav__item-title">{{ link.title }}</span>
              </span>
              <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="mobile-nav__accordion-content">
              <a href="{{ link.url }}" class="mobile-nav__shop-all-link">
                <span>{{ 'sections.header.shop_all' | t | default: 'Shop All' }} {{ link.title }}</span>
                <span aria-hidden="true">{% if is_rtl %}&larr;{% else %}&rarr;{% endif %}</span>
              </a>

              {%- assign m_source = section.settings.mega_menu_source | default: 'auto' -%}
              {%- assign nav_cols = nil -%}
              {%- if section.settings.mega_menu_linklist != blank and linklists[section.settings.mega_menu_linklist].links.size > 0 -%}
                {%- assign nav_cols = linklists[section.settings.mega_menu_linklist].links -%}
              {%- elsif link.links.size > 0 -%}
                {%- assign nav_cols = link.links -%}
              {%- endif -%}

              {%- assign use_nav_mode = false -%}
              {%- if m_source == 'navigation' and nav_cols != nil and nav_cols.size > 0 -%}
                {%- assign use_nav_mode = true -%}
              {%- elsif m_source == 'auto' and nav_cols != nil and nav_cols.size > 0 -%}
                {%- assign use_nav_mode = true -%}
              {%- endif -%}

              {%- if use_nav_mode -%}
                <!-- Sub-Accordions from Shopify Navigation (3-Level Menu) -->
                {%- for child in nav_cols -%}
                  {%- if child.links.size > 0 -%}
                    <div class="mobile-nav__sub-accordion">
                      <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                        <span>{{ child.title }}</span>
                        <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="mobile-nav__sub-accordion-content">
                        <a href="{{ child.url }}" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">Shop All {{ child.title }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}</a>
                        {%- for sub in child.links -%}
                          <a href="{{ sub.url }}" class="mobile-nav__sub-link">{{ sub.title }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}

                <!-- Featured Banner in Mobile Accordion if present -->
                {%- if matched_promo_block != nil -%}
                  {%- assign p_settings = matched_promo_block.settings -%}
                  <div style="margin-top: 14px; padding: 14px; background: var(--color-bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);" {{ matched_promo_block.shopify_attributes }}>
                    {%- if p_settings.badge != blank -%}
                      <span class="mega-menu__promo-tag" style="margin-bottom: 6px; background: rgba(0,0,0,0.6); color: #FFF;">{{ p_settings.badge }}</span>
                    {%- endif -%}
                    <strong style="display: block; font-size: 0.95rem; margin-bottom: 6px; color: var(--color-foreground);">{{ p_settings.title | default: 'Never Mind Streetwear Drop' }}</strong>
                    {%- if p_settings.description != blank -%}
                      <p style="font-size: 0.8rem; color: var(--color-foreground-secondary); margin-bottom: 8px;">{{ p_settings.description }}</p>
                    {%- endif -%}
                    <a href="{{ p_settings.button_url | default: '/collections/all' }}" class="btn btn-primary btn-sm btn-full" style="margin-top: 8px;">
                      {{ p_settings.button_text | default: 'Shop Now' }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}
                    </a>
                  </div>
                {%- endif -%}

              {%- elsif matched_columns_count > 0 -%}
                <!-- Sub-Accordions from mega_column blocks -->
                {%- for block in section.blocks -%}
                  {%- if block.type == 'mega_column' -%}
                    {%- assign b_trig = block.settings.menu_trigger | default: 'Catalog' | downcase | strip -%}
                    {%- if b_trig == downcased_title or b_trig == '' and downcased_title == 'catalog' -%}
                      {%- assign c_title = block.settings.title -%}
                      {%- assign c_url = block.settings.url -%}
                      {%- if block.settings.collection != blank -%}
                        {%- if c_title == blank -%}{%- assign c_title = block.settings.collection.title -%}{%- endif -%}
                        {%- if c_url == blank -%}{%- assign c_url = block.settings.collection.url -%}{%- endif -%}
                      {%- endif -%}
                      {%- if c_title == blank -%}{%- assign c_title = "Collection" -%}{%- endif -%}

                      <div class="mobile-nav__sub-accordion" {{ block.shopify_attributes }}>
                        <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                          <span>{{ c_title }}</span>
                          {%- if block.settings.badge_text != blank -%}
                            <span class="mega-menu__col-badge" style="font-size: 0.6rem; color: {{ block.settings.badge_color | default: '#FFFFFF' }}; background: {{ block.settings.badge_bg | default: '#E05A47' }}; margin-inline-start: 6px;">{{ block.settings.badge_text }}</span>
                          {%- endif -%}
                          <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>
                        <div class="mobile-nav__sub-accordion-content">
                          {%- if block.settings.show_shop_all -%}
                            <a href="{{ block.settings.shop_all_url | default: c_url | default: '#' }}" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">
                              {{ block.settings.shop_all_text | default: 'Shop All ' | append: c_title }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}
                            </a>
                          {%- endif -%}

                          {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                            {%- for sub in linklists[block.settings.menu].links -%}
                              <a href="{{ sub.url }}" class="mobile-nav__sub-link">{{ sub.title }}</a>
                            {%- endfor -%}
                          {%- else -%}
                            {%- if block.settings.link_1_title != blank -%}<a href="{{ block.settings.link_1_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_1_title }}</a>{%- endif -%}
                            {%- if block.settings.link_2_title != blank -%}<a href="{{ block.settings.link_2_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_2_title }}</a>{%- endif -%}
                            {%- if block.settings.link_3_title != blank -%}<a href="{{ block.settings.link_3_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_3_title }}</a>{%- endif -%}
                            {%- if block.settings.link_4_title != blank -%}<a href="{{ block.settings.link_4_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_4_title }}</a>{%- endif -%}
                            {%- if block.settings.link_5_title != blank -%}<a href="{{ block.settings.link_5_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_5_title }}</a>{%- endif -%}
                            {%- if block.settings.link_6_title != blank -%}<a href="{{ block.settings.link_6_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_6_title }}</a>{%- endif -%}
                            {%- if block.settings.link_7_title != blank -%}<a href="{{ block.settings.link_7_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_7_title }}</a>{%- endif -%}
                            {%- if block.settings.link_8_title != blank -%}<a href="{{ block.settings.link_8_url | default: c_url }}" class="mobile-nav__sub-link">{{ block.settings.link_8_title }}</a>{%- endif -%}
                            {%- if block.settings.sub_links_text != blank -%}
                              {%- assign lines = block.settings.sub_links_text | newline_to_br | split: '<br />' -%}
                              {%- for line in lines -%}
                                {%- assign clean_line = line | strip -%}
                                {%- if clean_line != blank -%}
                                  {%- assign parts = clean_line | split: '|' -%}
                                  <a href="{{ parts[1] | strip | default: c_url }}" class="mobile-nav__sub-link">{{ parts[0] | strip }}</a>
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                <!-- Featured Banner in Mobile Accordion -->
                {%- if matched_promo_block != nil -%}
                  {%- assign p_settings = matched_promo_block.settings -%}
                  <div style="margin-top: 14px; padding: 14px; background: var(--color-bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);" {{ matched_promo_block.shopify_attributes }}>
                    {%- if p_settings.badge != blank -%}
                      <span class="mega-menu__promo-tag" style="margin-bottom: 6px; background: rgba(0,0,0,0.6); color: #FFF;">{{ p_settings.badge }}</span>
                    {%- endif -%}
                    <strong style="display: block; font-size: 0.95rem; margin-bottom: 6px; color: var(--color-foreground);">{{ p_settings.title | default: 'Never Mind Streetwear Drop' }}</strong>
                    {%- if p_settings.description != blank -%}
                      <p style="font-size: 0.8rem; color: var(--color-foreground-secondary); margin-bottom: 8px;">{{ p_settings.description }}</p>
                    {%- endif -%}
                    <a href="{{ p_settings.button_url | default: '/collections/all' }}" class="btn btn-primary btn-sm btn-full" style="margin-top: 8px;">
                      {{ p_settings.button_text | default: 'Shop Now' }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}
                    </a>
                  </div>
                {%- endif -%}

              {%- elsif matched_full_block != nil -%}
                <!-- Backward compatible mega_menu block accordions -->
                {%- assign b = matched_full_block -%}
                {%- if b.settings.col_1_title != blank -%}
                  <div class="mobile-nav__sub-accordion">
                    <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                      <span>{{ b.settings.col_1_title }}</span>
                      <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <div class="mobile-nav__sub-accordion-content">
                      <a href="{{ b.settings.col_1_url | default: '/collections/men' }}" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">Shop All {{ b.settings.col_1_title }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}</a>
                      {%- if b.settings.col_1_link_1_title != blank -%}<a href="{{ b.settings.col_1_link_1_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_1_link_1_title }}</a>{%- endif -%}
                      {%- if b.settings.col_1_link_2_title != blank -%}<a href="{{ b.settings.col_1_link_2_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_1_link_2_title }}</a>{%- endif -%}
                      {%- if b.settings.col_1_link_3_title != blank -%}<a href="{{ b.settings.col_1_link_3_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_1_link_3_title }}</a>{%- endif -%}
                      {%- if b.settings.col_1_link_4_title != blank -%}<a href="{{ b.settings.col_1_link_4_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_1_link_4_title }}</a>{%- endif -%}
                      {%- if b.settings.col_1_link_5_title != blank -%}<a href="{{ b.settings.col_1_link_5_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_1_link_5_title }}</a>{%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
                {%- if b.settings.col_2_title != blank -%}
                  <div class="mobile-nav__sub-accordion">
                    <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                      <span>{{ b.settings.col_2_title }}</span>
                      <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <div class="mobile-nav__sub-accordion-content">
                      <a href="{{ b.settings.col_2_url | default: '/collections/women' }}" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">Shop All {{ b.settings.col_2_title }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}</a>
                      {%- if b.settings.col_2_link_1_title != blank -%}<a href="{{ b.settings.col_2_link_1_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_2_link_1_title }}</a>{%- endif -%}
                      {%- if b.settings.col_2_link_2_title != blank -%}<a href="{{ b.settings.col_2_link_2_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_2_link_2_title }}</a>{%- endif -%}
                      {%- if b.settings.col_2_link_3_title != blank -%}<a href="{{ b.settings.col_2_link_3_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_2_link_3_title }}</a>{%- endif -%}
                      {%- if b.settings.col_2_link_4_title != blank -%}<a href="{{ b.settings.col_2_link_4_url | default: '#' }}" class="mobile-nav__sub-link">{{ b.settings.col_2_link_4_title }}</a>{%- endif -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- elsif link.links.size > 0 or section.settings.mega_menu_linklist != blank -%}
                <!-- Navigation 3-Level Menu Sub-Accordions -->
                {%- assign nav_cols = link.links -%}
                {%- if section.settings.mega_menu_linklist != blank and linklists[section.settings.mega_menu_linklist].links.size > 0 -%}
                  {%- assign nav_cols = linklists[section.settings.mega_menu_linklist].links -%}
                {%- endif -%}
                {%- for child in nav_cols -%}
                  {%- if child.links.size > 0 -%}
                    <div class="mobile-nav__sub-accordion">
                      <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                        <span>{{ child.title }}</span>
                        <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="mobile-nav__sub-accordion-content">
                        <a href="{{ child.url }}" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">Shop All {{ child.title }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}</a>
                        {%- for sub in child.links -%}
                          <a href="{{ sub.url }}" class="mobile-nav__sub-link">{{ sub.title }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}

              {%- else -%}
                <!-- Default Streetwear Categories Sub-Accordions -->
                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% if is_rtl %}رجالي (Men){% else %}Men's Streetwear{% endif %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/men" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">{% if is_rtl %}تسوق كل تشكيلة الرجال &larr;{% else %}Shop All Men's &rarr;{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if is_rtl %}تيشيرتات أوفر سايز{% else %}Oversized T-Shirts{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if is_rtl %}تيشيرتات جرافيك وطباعة{% else %}Graphic & Printed Tees{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if is_rtl %}هوديز وسويت شيرت سميك{% else %}Heavyweight Hoodies{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if is_rtl %}بنطلونات كارجو وسويت بانتس{% else %}Tactical Cargo & Pants{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if is_rtl %}أطقم قطعتين وترينجات{% else %}Matching Sets & Tracksuits{% endif %}</a>
                  </div>
                </div>

                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% if is_rtl %}حريمي (Women){% else %}Women's Collection{% endif %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/women" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">{% if is_rtl %}تسوق كل تشكيلة النساء &larr;{% else %}Shop All Women's &rarr;{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if is_rtl %}توبات وتيشيرتات واسعة{% else %}Cropped & Oversized Tops{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if is_rtl %}هوديز وسويت شيرت مريح{% else %}Minimalist Lounge Hoodies{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if is_rtl %}بنطلونات واسعة وكارجو{% else %}Wide-Leg Pants & Cargo{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if is_rtl %}أطقم ملابس مريحة{% else %}Comfort Matching Sets{% endif %}</a>
                  </div>
                </div>

                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% if is_rtl %}أطفال وناشئين (Kids){% else %}Kids & Teens{% endif %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/kids" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">{% if is_rtl %}تسوق كل تشكيلة الأطفال &larr;{% else %}Shop All Kids &rarr;{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if is_rtl %}تيشيرتات جرافيك أولاد{% else %}Boys Graphic Tees{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if is_rtl %}ملابس كاجوال بنات{% else %}Girls Casual & Tops{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if is_rtl %}هوديز وترينجات أطفال{% else %}Kids Hoodies & Sweats{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if is_rtl %}أساسيات المراهقين{% else %}Teen Streetwear Essentials{% endif %}</a>
                  </div>
                </div>
              {%- endif -%}

              <!-- Mobile Promo Card inside Accordion if enabled on section -->
              {%- if section.settings.show_promo_banner and matched_promo_block == nil -%}
                <div style="margin-top: 14px; padding: 14px; background: var(--color-bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);">
                  {%- if section.settings.promo_badge != blank -%}
                    <span class="mega-menu__promo-tag" style="margin-bottom: 6px; background: rgba(0,0,0,0.6); color: #FFF;">{{ section.settings.promo_badge }}</span>
                  {%- endif -%}
                  <strong style="display: block; font-size: 0.95rem; margin-bottom: 6px; color: var(--color-foreground);">{{ section.settings.promo_title | default: 'Never Mind Streetwear Drop' }}</strong>
                  <a href="{{ section.settings.promo_url | default: '/collections/all' }}" class="btn btn-primary btn-sm btn-full" style="margin-top: 8px;">
                    {{ section.settings.promo_btn | default: 'Shop Now' }} {% if is_rtl %}&larr;{% else %}&rarr;{% endif %}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>

        {%- elsif has_children -%}
          <!-- Regular Dropdown Accordion -->
          <div class="mobile-nav__item mobile-nav__item--accordion">
            <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
              <span class="mobile-nav__title-wrap">
                <span class="mobile-nav__item-title">{{ link.title }}</span>
              </span>
              <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="mobile-nav__accordion-content">
              {%- for child in link.links -%}
                <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <!-- Direct Single Link -->
          <div class="mobile-nav__item">
            <a href="{{ link.url }}" class="mobile-nav__item-link">
              <span>{{ link.title }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Standalone Best Sellers & Sale if not in menu -->
      {%- if section.settings.show_best_sellers and has_bestsellers_in_menu == false -%}
        <div class="mobile-nav__item">
          <a href="/collections/best-sellers" class="mobile-nav__item-link">
            <span>{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}BEST SELLERS{% endif %}</span>
            <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.show_sale and has_sale_in_menu == false -%}
        <div class="mobile-nav__item">
          <a href="/collections/sale" class="mobile-nav__item-link" style="color: var(--color-sale);">
            <span>{% if request.locale.iso_code == 'ar' %}تخفيضات{% else %}SALE{% endif %}</span>
            <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Mobile Bottom Utilities (Account, Wishlist, Egypt COD Guarantee) -->
    <div class="mobile-nav__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav__footer-link">
          {% render 'icon-account' %}
          <span>{% if customer %}{{ 'customer.account.title' | t | default: 'My Account' }}{% else %}{{ 'customer.login_page.sign_in' | t | default: 'Sign In / Register' }}{% endif %}</span>
        </a>
      {%- endif -%}

      <a href="/pages/wishlist" class="mobile-nav__footer-link" data-wishlist-open>
        {% render 'icon-heart' %}
        <span>{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}</span>
        <span class="badge" data-wishlist-count style="display: none; margin-inline-start: auto;">0</span>
      </a>

      <div class="mobile-nav__trust-badge">
        <div class="mobile-nav__trust-icon">🇪🇬</div>
        <div>
          <strong>Never Mind Egypt</strong><br>
          <span style="font-size: 0.8rem; color: var(--color-foreground-secondary);">
            {% if request.locale.iso_code == 'ar' %}
              دفع عند الاستلام • معاينة الشحنة قبل الدفع
            {% else %}
              Cash on Delivery Available • Inspect Before Paying
            {% endif %}
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Store Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Custom Logo Width",
      "default": 140
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu",
      "info": "Online Store > Navigation > Main menu"
    },
    {
      "type": "header",
      "content": "Main Mega Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_mega_menu",
      "label": "Enable Main Mega Menu",
      "default": true,
      "info": "Displays a multi-column mega menu with sub-collections and promotional banner card on desktop."
    },
    {
      "type": "text",
      "id": "mega_menu_trigger",
      "label": "Menu Item to Open Mega Menu",
      "default": "Catalog",
      "info": "Name of the link in your Main Menu that opens this mega menu (e.g. Catalog, Shop, Collections, or المتجر)."
    },
    {
      "type": "select",
      "id": "mega_menu_width",
      "label": "Mega Menu Dropdown Width",
      "options": [
        {
          "value": "container",
          "label": "Container Width (1320px)"
        },
        {
          "value": "full",
          "label": "Full Screen Width"
        }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "mega_menu_source",
      "label": "Mega Menu Content Source",
      "options": [
        {
          "value": "auto",
          "label": "Auto (Use Navigation 3-Level Menu if nested, else Blocks)"
        },
        {
          "value": "navigation",
          "label": "Shopify Navigation (Online Store > Navigation 3-Level Menu)"
        },
        {
          "value": "blocks",
          "label": "Theme Customizer Blocks (Mega Menu Column blocks)"
        }
      ],
      "default": "auto",
      "info": "Choose whether columns are populated from your standard Shopify Navigation menu hierarchy or individual Theme Customizer blocks."
    },
    {
      "type": "link_list",
      "id": "mega_menu_linklist",
      "label": "Custom Mega Menu Columns Menu (Optional)",
      "info": "Select a menu with child links to customize the columns. If left blank or if blocks are added, custom settings take effect."
    },
    {
      "type": "header",
      "content": "Mega Menu Promotional Banner (Fallback)"
    },
    {
      "type": "checkbox",
      "id": "show_promo_banner",
      "label": "Show Promotional Banner Card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promotional Banner Image"
    },
    {
      "type": "text",
      "id": "promo_badge",
      "label": "Promo Badge Pill Text",
      "default": "NEW DROP 2026"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Promotional Heading",
      "default": "Never Mind Streetwear Drop"
    },
    {
      "type": "url",
      "id": "promo_url",
      "label": "Promotional Destination Link"
    },
    {
      "type": "text",
      "id": "promo_btn",
      "label": "Promotional Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Featured Quick Links"
    },
    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show Best Sellers Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale",
      "label": "Show Sale Link (Highlighted)",
      "default": true
    }
  ],
  "max_blocks": 25,
  "blocks": [
    {
      "type": "mega_column",
      "name": "Mega Menu Column",
      "settings": [
        {
          "type": "header",
          "content": "Menu Assignment"
        },
        {
          "type": "text",
          "id": "menu_trigger",
          "label": "Menu Item to Open Mega Menu",
          "default": "Catalog",
          "info": "Name of the link in your Main Menu (e.g. Catalog, Shop, or Collections)"
        },
        {
          "type": "header",
          "content": "Column Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "Men's Streetwear",
          "info": "Leave blank to use Collection title if selected below"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Column Title Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection (Optional)",
          "info": "Automatically supplies Title, Link, and Image if left blank"
        },
        {
          "type": "header",
          "content": "Column Image (Optional)"
        },
        {
          "type": "checkbox",
          "id": "show_collection_image",
          "label": "Show Image Above Column",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Column Thumbnail (Overrides collection image)"
        },
        {
          "type": "header",
          "content": "Column Badge (Optional)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "info": "e.g. HOT, NEW, SALE"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Text Color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge Background Color",
          "default": "#E05A47"
        },
        {
          "type": "header",
          "content": "Sub-Links (Navigation Menu or Manual)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Sub-Links Menu (Optional)",
          "info": "Select any navigation menu from Shopify Admin > Navigation"
        },
        {
          "type": "textarea",
          "id": "sub_links_text",
          "label": "Quick Links (One per line: Title | URL)",
          "info": "Example: Oversized Tees | /collections/men"
        },
        {
          "type": "text",
          "id": "link_1_title",
          "label": "Sub-link 1 Title",
          "default": "Oversized T-Shirts"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Sub-link 1 Link"
        },
        {
          "type": "text",
          "id": "link_2_title",
          "label": "Sub-link 2 Title",
          "default": "Graphic & Printed Tees"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Sub-link 2 Link"
        },
        {
          "type": "text",
          "id": "link_3_title",
          "label": "Sub-link 3 Title",
          "default": "Heavyweight Hoodies"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Sub-link 3 Link"
        },
        {
          "type": "text",
          "id": "link_4_title",
          "label": "Sub-link 4 Title",
          "default": "Tactical Cargo & Pants"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Sub-link 4 Link"
        },
        {
          "type": "text",
          "id": "link_5_title",
          "label": "Sub-link 5 Title",
          "default": "Matching Sets & Tracksuits"
        },
        {
          "type": "url",
          "id": "link_5_url",
          "label": "Sub-link 5 Link"
        },
        {
          "type": "text",
          "id": "link_6_title",
          "label": "Sub-link 6 Title"
        },
        {
          "type": "url",
          "id": "link_6_url",
          "label": "Sub-link 6 Link"
        },
        {
          "type": "text",
          "id": "link_7_title",
          "label": "Sub-link 7 Title"
        },
        {
          "type": "url",
          "id": "link_7_url",
          "label": "Sub-link 7 Link"
        },
        {
          "type": "text",
          "id": "link_8_title",
          "label": "Sub-link 8 Title"
        },
        {
          "type": "url",
          "id": "link_8_url",
          "label": "Sub-link 8 Link"
        },
        {
          "type": "header",
          "content": "Shop All CTA Link"
        },
        {
          "type": "checkbox",
          "id": "show_shop_all",
          "label": "Show 'Shop All' Link at Bottom",
          "default": true
        },
        {
          "type": "text",
          "id": "shop_all_text",
          "label": "Shop All Label (Leave blank for auto)",
          "placeholder": "Shop All Men's →"
        },
        {
          "type": "url",
          "id": "shop_all_url",
          "label": "Shop All Destination URL (Leave blank to use column URL)"
        }
      ]
    },
    {
      "type": "featured_card",
      "name": "Mega Menu Featured Banner",
