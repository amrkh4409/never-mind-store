                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}توبات وتيشيرتات{% else %}Tops & T-Shirts{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}كروب توب قطن عصري{% else %}Cropped Heavyweight Tees{% endif %}</a>
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات أوفر سايز بناتي{% else %}Oversized Graphic Tees{% endif %}</a>
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}توبات بيسك كاجوال{% else %}Basic Ribbed Tank Tops{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}هوديز وسويت شيرت{% else %}Hoodies & Sweats{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز لاونج مريح فاخر{% else %}Minimalist Lounge Hoodies{% endif %}</a>
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}كروب هوديز وسويتر عصري{% else %}Cropped Sweaters{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}بنطلونات وليجن{% else %}Pants & Leggings{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بنطلونات فلير واسعة (Wide Leg){% else %}Wide-Leg Comfort Pants{% endif %}</a>
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بنطلونات كارجو خصر عالي{% else %}High-Waist Cargo Pants{% endif %}</a>
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}سويت بانتس مريح للمنزل والشارع{% else %}Relaxed Fit Sweatpants{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}أطقم وبيجامات{% else %}Sets & Loungewear{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أطقم قطعتين متناسقة (Co-ord){% else %}Matching 2-Piece Sets{% endif %}</a>
                  <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بيجامات وملابس منزلية مريحة{% else %}Comfort Loungewear{% endif %}</a>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- 3. KIDS ACCORDION -->
      {%- if section.settings.show_kids -%}
        <div class="mobile-nav__item mobile-nav__item--accordion">
          <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
            <span class="mobile-nav__title-wrap">
              <span class="mobile-nav__item-title">{% if request.locale.iso_code == 'ar' %}أطفال وناشئين{% else %}KIDS & TEENS{% endif %}</span>
            </span>
            <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="mobile-nav__accordion-content">
            <a href="/collections/kids" class="mobile-nav__shop-all-link">
              <span>{{ 'sections.header.shop_all' | t | default: 'Shop All' }} {% if request.locale.iso_code == 'ar' %}أطفال{% else %}KIDS{% endif %}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>

            {%- if section.settings.kids_menu != blank and linklists[section.settings.kids_menu].links.size > 0 -%}
              {%- for child in linklists[section.settings.kids_menu].links -%}
                {%- if child.links.size > 0 -%}
                  <div class="mobile-nav__sub-accordion">
                    <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                      <span>{{ child.title }}</span>
                      <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <div class="mobile-nav__sub-accordion-content">
                      {%- for grandchild in child.links -%}
                        <a href="{{ grandchild.url }}" class="mobile-nav__sub-link">{{ grandchild.title }}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}كولكشن ولادي{% else %}Boys Collection{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات ولادي مطبوعة{% else %}Boys Graphic Tees{% endif %}</a>
                  <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بنطلونات وشورتات ولادي{% else %}Boys Pants & Shorts{% endif %}</a>
                  <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أطقم ولادي قطعتين{% else %}Boys 2-Piece Sets{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}كولكشن بناتي{% else %}Girls Collection{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}توبات وتيشيرتات بناتي لطيفة{% else %}Girls Tops & Tees{% endif %}</a>
                  <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز وسويت شيرت بناتي{% else %}Girls Hoodies & Sweats{% endif %}</a>
                  <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أطقم وليجن خروج ومنزل{% else %}Girls Sets & Leggings{% endif %}</a>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- 4. BEST SELLERS LINK -->
      {%- if section.settings.show_best_sellers -%}
        <a href="/collections/best-sellers" class="mobile-nav__single-link">
          <span>{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}BEST SELLERS{% endif %}</span>
          <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
        </a>
      {%- endif -%}

      <!-- 5. SALE LINK -->
      {%- if section.settings.show_sale -%}
        <a href="/collections/sale" class="mobile-nav__single-link mobile-nav__single-link--sale">
          <span>{% if request.locale.iso_code == 'ar' %}تخفيضات{% else %}SALE{% endif %}</span>
          <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
        </a>
      {%- endif -%}

      <!-- Additional links -->
      {%- for link in raw_links -%}
        {%- assign dt = link.title | downcase -%}
        {%- unless dt contains 'home' or dt contains 'الرئيسية' or dt contains 'catalog' or dt contains 'المنتجات' -%}
          <a href="{{ link.url }}" class="mobile-nav__single-link">
            <span>{{ link.title }}</span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    <!-- Mobile Bottom Utilities (Account, Wishlist, Egypt COD Guarantee) -->
    <div class="mobile-nav__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav__footer-link">
          {% render 'icon-account' %}
          <span>{% if customer %}{{ 'customer.account.title' | t | default: 'My Account' }}{% else %}{{ 'customer.login_page.sign_in' | t | default: 'Sign In / Register' }}{% endif %}</span>
        </a>
      {%- endif -%}

      <a href="/pages/wishlist" class="mobile-nav__footer-link" data-wishlist-open>
        {% render 'icon-heart' %}
        <span>{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}</span>
        <span class="badge" data-wishlist-count style="display: none; margin-inline-start: auto;">0</span>
      </a>

      <div class="mobile-nav__trust-badge">
        <div class="mobile-nav__trust-icon">🇪🇬</div>
        <div>
          <strong>Never Mind Egypt</strong><br>
          <span style="font-size: 0.8rem; color: var(--color-foreground-secondary);">
            {% if request.locale.iso_code == 'ar' %}
              دفع عند الاستلام • معاينة الشحنة قبل الدفع
            {% else %}
              Cash on Delivery Available • Inspect Before Paying
            {% endif %}
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo & Main Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Store Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Custom Logo Width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu",
      "info": "To use custom Shopify navigation, add items here. If left default, the Modex Streetwear menu will display."
    },
    {
      "type": "checkbox",
      "id": "enable_mega_menu",
      "label": "Enable Modern Mega Menus",
      "default": true,
      "info": "Displays multi-column dropdowns for categories and sub-collections inspired by leading streetwear fashion stores."
    },
    {
      "type": "header",
      "content": "Collections Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_men",
      "label": "Show Men Collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_women",
      "label": "Show Women Collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_kids",
      "label": "Show Kids Collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show Best Sellers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale",
      "label": "Show Sale (Red Accent)",
      "default": true
    },
    {
      "type": "header",
      "content": "Men's Mega Menu Customization"
    },
    {
      "type": "link_list",
      "id": "men_menu",
      "label": "Custom Men Menu (Optional)",
      "info": "Leave blank to use the default curated Modex men's categories."
    },
    {
      "type": "image_picker",
      "id": "men_promo_image",
      "label": "Men Promotional Banner Image"
    },
    {
      "type": "text",
      "id": "men_promo_badge",
      "label": "Men Promo Badge",
      "default": "NEW DROP"
    },
    {
      "type": "text",
      "id": "men_promo_title",
      "label": "Men Promo Title",
      "default": "Men's New Drop 2026"
    },
    {
      "type": "url",
      "id": "men_promo_url",
      "label": "Men Promo Link"
    },
    {
      "type": "text",
      "id": "men_promo_btn",
      "label": "Men Promo Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Women's Mega Menu Customization"
    },
    {
      "type": "link_list",
      "id": "women_menu",
      "label": "Custom Women Menu (Optional)",
      "info": "Leave blank to use the default curated Modex women's categories."
    },
    {
      "type": "image_picker",
      "id": "women_promo_image",
      "label": "Women Promotional Banner Image"
    },
    {
      "type": "text",
      "id": "women_promo_badge",
      "label": "Women Promo Badge",
      "default": "TRENDING"
    },
    {
      "type": "text",
      "id": "women_promo_title",
      "label": "Women Promo Title",
      "default": "Women's Collection 2026"
    },
    {
      "type": "url",
      "id": "women_promo_url",
      "label": "Women Promo Link"
    },
    {
      "type": "text",
      "id": "women_promo_btn",
      "label": "Women Promo Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Kids' Mega Menu Customization"
    },
    {
      "type": "link_list",
      "id": "kids_menu",
      "label": "Custom Kids Menu (Optional)",
      "info": "Leave blank to use the default curated Modex kids' categories."
    },
    {
      "type": "image_picker",
      "id": "kids_promo_image",
      "label": "Kids Promotional Banner Image"
    },
    {
      "type": "text",
      "id": "kids_promo_badge",
      "label": "Kids Promo Badge",
      "default": "KIDS DROP"
    },
    {
      "type": "text",
      "id": "kids_promo_title",
      "label": "Kids Promo Title",
      "default": "Kids Streetwear 2026"
    },
    {
      "type": "url",
      "id": "kids_promo_url",
      "label": "Kids Promo Link"
    },
    {
      "type": "text",
      "id": "kids_promo_btn",
      "label": "Kids Promo Button Text",
      "default": "Shop Now"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Custom Mega Menu Block",
      "settings": [
        {
          "type": "text",
          "id": "trigger_title",
          "label": "Menu Item Title",
          "info": "Name of the link in the header navigation (e.g. Accessories, Hoodies, Summer Drop)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Columns Menu Linklist",
          "info": "Select a menu with child links to display as columns."
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "promo_badge",
          "label": "Badge Pill Text",
          "default": "HOT"
        },
        {
          "type": "text",
          "id": "promo_title",
          "label": "Promotional Heading",
          "default": "Featured Drop"
        },
        {
          "type": "url",
          "id": "promo_url",
          "label": "Banner Destination Link"
        },
        {
          "type": "text",
          "id": "promo_button_text",
          "label": "Button Label",
          "default": "Shop Now"
        }
      ]
    }
  ]
}
{% endschema %}
