          </button>
          <div class="mobile-nav__accordion-content">
            <a href="/collections/women" class="mobile-nav__shop-all-link">
              <span>{{ 'sections.header.shop_all' | t | default: 'Shop All' }} {% if request.locale.iso_code == 'ar' %}حريمي{% else %}WOMEN{% endif %}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>

            {%- if section.settings.women_menu != blank and linklists[section.settings.women_menu].links.size > 0 -%}
