<header class="header-wrapper" id="site-header">
  <div class="container header">
    <!-- Mobile Hamburger Toggle -->
    <div class="header__left">
      <button
        type="button"
        class="header__mobile-toggle"
        data-mobile-menu-toggle
        aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}"
        aria-controls="MobileNavDrawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            width="{{ section.settings.logo_width }}"
          >
        {%- else -%}
          <img
            src="{{ 'logo.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            style="height: {{ section.settings.logo_width | divided_by: 3 | default: 42 }}px;"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Check if Shopify menu already has fashion collections -->
    {%- assign raw_links = linklists[section.settings.menu].links -%}
    {%- assign has_fashion_in_menu = false -%}
    {%- for link in raw_links -%}
      {%- assign dt = link.title | downcase -%}
      {%- if dt contains 'men' or dt contains 'رجالي' or dt contains 'women' or dt contains 'حريمي' or dt contains 'kid' or dt contains 'أطفال' -%}
        {%- assign has_fashion_in_menu = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    <!-- Desktop Navigation Menu -->
    <nav class="header__nav" aria-label="Main Navigation">
      {%- if has_fashion_in_menu -%}
        <!-- Render merchant's custom menu from Navigation > Main menu -->
        {%- for link in raw_links -%}
          {%- assign downcased_title = link.title | downcase -%}
          {%- assign is_sale = false -%}
          {%- assign is_hot = false -%}
          {%- assign is_new = false -%}

          {%- if downcased_title contains 'sale' or downcased_title contains 'تخفيض' or downcased_title contains 'عروض' -%}
            {%- assign is_sale = true -%}
          {%- elsif downcased_title contains 'best' or downcased_title contains 'الأكثر' or downcased_title contains 'top' -%}
            {%- assign is_hot = true -%}
          {%- elsif downcased_title contains 'new' or downcased_title contains 'جديد' -%}
            {%- assign is_new = true -%}
          {%- endif -%}

          {%- assign has_grandchildren = false -%}
          {%- if link.links.size > 0 -%}
            {%- for child_link in link.links -%}
              {%- if child_link.links.size > 0 -%}
                {%- assign has_grandchildren = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- assign is_men = false -%}
          {%- assign is_women = false -%}
          {%- assign is_kids = false -%}
          {%- if downcased_title contains 'men' or downcased_title contains 'رجالي' -%}
            {%- assign is_men = true -%}
          {%- elsif downcased_title contains 'women' or downcased_title contains 'حريمي' or downcased_title contains 'نسائي' -%}
            {%- assign is_women = true -%}
          {%- elsif downcased_title contains 'kid' or downcased_title contains 'أطفال' or downcased_title contains 'ناشئين' -%}
            {%- assign is_kids = true -%}
          {%- endif -%}

          {%- assign show_mega = false -%}
          {%- if section.settings.enable_mega_menu -%}
            {%- if has_grandchildren or is_men or is_women or is_kids -%}
              {%- assign show_mega = true -%}
            {%- endif -%}
          {%- endif -%}

          <div class="header__menu-item {% if show_mega %}header__menu-item--has-mega{% elsif link.links.size > 0 %}header__menu-item--has-dropdown{% endif %} {% if is_sale %}header__menu-item--sale{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link">
              <span>{{ link.title }}</span>
              {%- if is_sale -%}
                <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
              {%- elsif is_hot -%}
                <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
              {%- elsif is_new -%}
                <span class="nav-badge nav-badge--new">{{ 'sections.header.new' | t | default: 'NEW' }}</span>
              {%- endif -%}
              {%- if show_mega or link.links.size > 0 -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              {%- endif -%}
            </a>

            {%- if show_mega -%}
              <div class="mega-menu">
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {%- if has_grandchildren -%}
                      {%- for child_link in link.links -%}
                        <div class="mega-menu__col">
                          <a href="{{ child_link.url }}" class="mega-menu__heading">{{ child_link.title }}</a>
                          {%- if child_link.links.size > 0 -%}
                            <ul class="mega-menu__list">
                              {%- for grandchild_link in child_link.links -%}
                                <li class="mega-menu__item">
                                  <a href="{{ grandchild_link.url }}" class="mega-menu__link">{{ grandchild_link.title }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    {%- elsif is_men -%}
                      {% render 'mega-menu-men' %}
                    {%- elsif is_women -%}
                      {% render 'mega-menu-women' %}
                    {%- elsif is_kids -%}
                      {% render 'mega-menu-kids' %}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- elsif link.links.size > 0 -%}
              <div class="header__dropdown">
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}" class="header__dropdown-link">{{ child_link.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

      {%- else -%}
        <!-- Modex Streetwear Navigation (Customizable from Shopify Theme Editor) -->

        <!-- 1. MEN -->
        {%- if section.settings.show_men -%}
          <div class="header__menu-item {% if section.settings.enable_mega_menu %}header__menu-item--has-mega{% endif %}">
            <a href="/collections/men" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}رجالي{% else %}MEN{% endif %}</span>
              {%- if section.settings.enable_mega_menu -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              {%- endif -%}
            </a>
            {%- if section.settings.enable_mega_menu -%}
              <div class="mega-menu">
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {% render 'mega-menu-men' %}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- 2. WOMEN -->
        {%- if section.settings.show_women -%}
          <div class="header__menu-item {% if section.settings.enable_mega_menu %}header__menu-item--has-mega{% endif %}">
            <a href="/collections/women" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}حريمي{% else %}WOMEN{% endif %}</span>
              {%- if section.settings.enable_mega_menu -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              {%- endif -%}
            </a>
            {%- if section.settings.enable_mega_menu -%}
              <div class="mega-menu">
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {% render 'mega-menu-women' %}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- 3. KIDS & TEENS -->
        {%- if section.settings.show_kids -%}
          <div class="header__menu-item {% if section.settings.enable_mega_menu %}header__menu-item--has-mega{% endif %}">
            <a href="/collections/kids" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}أطفال وناشئين{% else %}KIDS & TEENS{% endif %}</span>
              {%- if section.settings.enable_mega_menu -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              {%- endif -%}
            </a>
            {%- if section.settings.enable_mega_menu -%}
              <div class="mega-menu">
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {% render 'mega-menu-kids' %}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- 4. BEST SELLERS -->
        {%- if section.settings.show_best_sellers -%}
          <div class="header__menu-item">
            <a href="/collections/best-sellers" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}BEST SELLERS{% endif %}</span>
              <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
            </a>
          </div>
        {%- endif -%}

        <!-- 5. SALE -->
        {%- if section.settings.show_sale -%}
          <div class="header__menu-item header__menu-item--sale">
            <a href="/collections/sale" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}تخفيضات{% else %}SALE{% endif %}</span>
              <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
            </a>
          </div>
        {%- endif -%}

        <!-- Custom Additional Mega-Menu Blocks from Theme Editor -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_menu' and block.settings.trigger_title != blank -%}
            <div class="header__menu-item header__menu-item--has-mega" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.promo_url | default: '#' }}" class="header__menu-link">
                <span>{{ block.settings.trigger_title }}</span>
                {%- if block.settings.promo_badge != blank -%}
                  <span class="nav-badge nav-badge--hot">{{ block.settings.promo_badge }}</span>
                {%- endif -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </a>
              <div class="mega-menu">
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                      {%- for col_link in linklists[block.settings.menu].links -%}
                        <div class="mega-menu__col">
                          <a href="{{ col_link.url }}" class="mega-menu__heading">{{ col_link.title }}</a>
                          {%- if col_link.links.size > 0 -%}
                            <ul class="mega-menu__list">
                              {%- for sub in col_link.links -%}
                                <li class="mega-menu__item"><a href="{{ sub.url }}" class="mega-menu__link">{{ sub.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}

                    {%- if block.settings.promo_image != blank or block.settings.promo_title != blank -%}
                      <div class="mega-menu__promo-col">
                        <a href="{{ block.settings.promo_url | default: '#' }}" class="mega-menu__promo">
                          {%- if block.settings.promo_image != blank -%}
                            <div class="mega-menu__promo-img-wrap">
                              <img src="{{ block.settings.promo_image | image_url: width: 600 }}" alt="{{ block.settings.promo_title }}" class="mega-menu__promo-img" loading="lazy">
                              <div class="mega-menu__promo-overlay"></div>
                            </div>
                          {%- endif -%}
                          <div class="mega-menu__promo-content">
                            {%- if block.settings.promo_badge != blank -%}
                              <span class="mega-menu__promo-tag">{{ block.settings.promo_badge }}</span>
                            {%- endif -%}
                            <h4 class="mega-menu__promo-title">{{ block.settings.promo_title }}</h4>
                            {%- if block.settings.promo_button_text != blank -%}
                              <span class="mega-menu__promo-btn">
                                {{ block.settings.promo_button_text }}
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                              </span>
                            {%- endif -%}
                          </div>
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <!-- Additional non-catalog links from user's Shopify navigation (e.g. Contact, About) -->
        {%- for link in raw_links -%}
          {%- assign dt = link.title | downcase -%}
          {%- unless dt contains 'home' or dt contains 'الرئيسية' or dt contains 'catalog' or dt contains 'المنتجات' -%}
            <div class="header__menu-item">
              <a href="{{ link.url }}" class="header__menu-link">
                <span>{{ link.title }}</span>
              </a>
            </div>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <!-- Header Actions (Search, Account, Wishlist, Cart) -->
    <div class="header__right">
      <!-- Language Switcher -->
      {% render 'localization-selector' %}

      <!-- Search Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-search-open
        aria-label="{{ 'sections.header.search' | t | default: 'Search' }}"
      >
        {% render 'icon-search' %}
      </button>

      <!-- Customer Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__icon-btn"
          aria-label="{{ 'sections.header.account' | t | default: 'Account' }}"
        >
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <!-- Wishlist Counter -->
      <button
        type="button"
        class="header__icon-btn"
        data-wishlist-open
        aria-label="{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}"
      >
        {% render 'icon-heart' %}
        <span class="header__wishlist-count" data-wishlist-count style="display: none;">0</span>
      </button>

      <!-- Cart Drawer Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-cart-open
        aria-label="{{ 'sections.header.cart' | t | default: 'Cart' }}"
      >
        {% render 'icon-cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop -->
<div id="MobileNavBackdrop" class="drawer-backdrop" data-mobile-menu-close></div>

<!-- Mobile Navigation Drawer (Modex Style 3-Tier Multi-Level Accordions) -->
<div id="MobileNavDrawer" class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">
  <div class="mobile-nav-drawer__header">
    <div class="header__logo">
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 36px;">
    </div>
    <button type="button" class="mobile-nav-drawer__close-btn" data-mobile-menu-close aria-label="Close menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="mobile-nav-drawer__body">
    <!-- Mobile Search Bar -->
    <div class="mobile-nav__search-box">
      <button
        type="button"
        class="btn btn-outline btn-full btn-sm"
        data-search-open
        style="justify-content: flex-start; gap: 10px; color: var(--color-foreground-secondary);"
      >
        {% render 'icon-search' %}
        <span>{{ 'general.search.placeholder' | t | default: 'Search collections...' }}</span>
      </button>
    </div>

    <!-- Mobile Navigation Links with Multi-Level Accordions -->
    <div class="mobile-nav__links">
      <!-- 1. MEN ACCORDION -->
      {%- if section.settings.show_men -%}
        <div class="mobile-nav__item mobile-nav__item--accordion">
          <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
            <span class="mobile-nav__title-wrap">
              <span class="mobile-nav__item-title">{% if request.locale.iso_code == 'ar' %}رجالي{% else %}MEN{% endif %}</span>
            </span>
            <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="mobile-nav__accordion-content">
            <a href="/collections/men" class="mobile-nav__shop-all-link">
              <span>{{ 'sections.header.shop_all' | t | default: 'Shop All' }} {% if request.locale.iso_code == 'ar' %}رجالي{% else %}MEN{% endif %}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>

            {%- if section.settings.men_menu != blank and linklists[section.settings.men_menu].links.size > 0 -%}
              {%- for child in linklists[section.settings.men_menu].links -%}
                {%- if child.links.size > 0 -%}
                  <div class="mobile-nav__sub-accordion">
                    <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                      <span>{{ child.title }}</span>
                      <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <div class="mobile-nav__sub-accordion-content">
                      {%- for grandchild in child.links -%}
                        <a href="{{ grandchild.url }}" class="mobile-nav__sub-link">{{ grandchild.title }}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}تيشيرتات وتوبات{% else %}T-Shirts & Tops{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات أوفر سايز (Oversized){% else %}Oversized T-Shirts{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات جرافيك مطبوعة{% else %}Graphic & Printed Tees{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات بيسك سادة{% else %}Basic Plain Tees{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}قمصان وبولو كاجوال{% else %}Casual Shirts & Polos{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}هوديز وسويت شيرت{% else %}Hoodies & Sweats{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز أوفر سايز سميك{% else %}Oversized Hoodies{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز بسحاب Zip-Up{% else %}Zip-Up Hoodies{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}سويت شيرت كلاسيك{% else %}Crewneck Sweatshirts{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}بنطلونات وشورتات{% else %}Pants & Shorts{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بنطلونات كارجو بجيوب{% else %}Tactical Cargo Pants{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}سويت بانتس مريح{% else %}Relaxed Sweatpants{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}جينز واسع عصري{% else %}Wide-Leg Jeans{% endif %}</a>
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}شورتات صيفية كاجوال{% else %}Summer Casual Shorts{% endif %}</a>
                </div>
              </div>

              <div class="mobile-nav__sub-accordion">
                <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                  <span>{% if request.locale.iso_code == 'ar' %}أطقم وترينجات{% else %}Sets & Tracksuits{% endif %}</span>
                  <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="mobile-nav__sub-accordion-content">
                  <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أطقم صيفية قطعتين (Set){% else %}Summer 2-Piece Sets{% endif %}</a>
