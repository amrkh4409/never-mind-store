<header class="header-wrapper" id="site-header">
  <div class="container header">
    <!-- Mobile Hamburger Toggle -->
    <div class="header__left">
      <button
        type="button"
        class="header__mobile-toggle"
        data-mobile-menu-toggle
        aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}"
        aria-controls="MobileNavDrawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            width="{{ section.settings.logo_width }}"
          >
        {%- else -%}
          <img
            src="{{ 'logo.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            style="height: {{ section.settings.logo_width | divided_by: 3 | default: 42 }}px;"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Menu -->
    <nav class="header__nav" aria-label="Main Navigation">
      {%- assign nav_links = linklists[section.settings.menu].links -%}
      {%- assign trigger_name = section.settings.mega_menu_trigger | downcase | strip -%}

      {%- if nav_links.size > 0 -%}
        {%- for link in nav_links -%}
          {%- assign downcased_title = link.title | downcase | strip -%}
          
          {%- assign is_mega = false -%}
          {%- if section.settings.enable_mega_menu -%}
            {%- if trigger_name != blank and downcased_title == trigger_name -%}
              {%- assign is_mega = true -%}
            {%- elsif trigger_name == blank or trigger_name == 'catalog' -%}
              {%- if downcased_title contains 'catalog' or downcased_title contains 'shop' or downcased_title contains 'collection' or downcased_title contains 'متجر' or downcased_title contains 'منتجات' or downcased_title contains 'تشكيلات' -%}
                {%- assign is_mega = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- assign has_block_mega = false -%}
          {%- assign block_mega_block = nil -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'mega_menu' and block.settings.trigger_title != blank -%}
              {%- assign block_trigger = block.settings.trigger_title | downcase | strip -%}
              {%- if block_trigger == downcased_title -%}
                {%- assign has_block_mega = true -%}
                {%- assign block_mega_block = block -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign is_sale = false -%}
          {%- assign is_hot = false -%}
          {%- assign is_new = false -%}
          {%- if downcased_title contains 'sale' or downcased_title contains 'تخفيض' or downcased_title contains 'عروض' -%}
            {%- assign is_sale = true -%}
          {%- elsif downcased_title contains 'best' or downcased_title contains 'الأكثر' or downcased_title contains 'top' -%}
            {%- assign is_hot = true -%}
          {%- elsif downcased_title contains 'new' or downcased_title contains 'جديد' -%}
            {%- assign is_new = true -%}
          {%- endif -%}

          {%- assign has_dropdown = false -%}
          {%- if link.links.size > 0 and is_mega == false and has_block_mega == false -%}
            {%- assign has_dropdown = true -%}
          {%- endif -%}

          <div class="header__menu-item {% if is_mega or has_block_mega %}header__menu-item--has-mega{% elsif has_dropdown %}header__menu-item--has-dropdown{% endif %} {% if is_sale %}header__menu-item--sale{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link">
              <span>{{ link.title }}</span>
              {%- if is_sale -%}
                <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
              {%- elsif is_hot -%}
                <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
              {%- elsif is_new -%}
                <span class="nav-badge nav-badge--new">{{ 'sections.header.new' | t | default: 'NEW' }}</span>
              {%- endif -%}
              {%- if is_mega or has_block_mega or has_dropdown -%}
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              {%- endif -%}
            </a>

            {%- if is_mega -%}
              <!-- Main Mega Menu Dropdown -->
              <div class="mega-menu">
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {% render 'mega-menu-main', link: link %}
                  </div>
                </div>
              </div>
            {%- elsif has_block_mega -%}
              <!-- Custom Block Mega Menu -->
              <div class="mega-menu" {{ block_mega_block.shopify_attributes }}>
                <div class="container mega-menu__container">
                  <div class="mega-menu__grid">
                    {%- if block_mega_block.settings.menu != blank and linklists[block_mega_block.settings.menu].links.size > 0 -%}
                      {%- for col_link in linklists[block_mega_block.settings.menu].links -%}
                        <div class="mega-menu__col">
                          <a href="{{ col_link.url }}" class="mega-menu__heading">{{ col_link.title }}</a>
                          {%- if col_link.links.size > 0 -%}
                            <ul class="mega-menu__list">
                              {%- for sub in col_link.links -%}
                                <li class="mega-menu__item"><a href="{{ sub.url }}" class="mega-menu__link">{{ sub.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}

                    {%- if block_mega_block.settings.promo_image != blank or block_mega_block.settings.promo_title != blank -%}
                      <div class="mega-menu__promo-col">
                        <a href="{{ block_mega_block.settings.promo_url | default: '#' }}" class="mega-menu__promo">
                          {%- if block_mega_block.settings.promo_image != blank -%}
                            <div class="mega-menu__promo-img-wrap">
                              <img src="{{ block_mega_block.settings.promo_image | image_url: width: 600 }}" alt="{{ block_mega_block.settings.promo_title }}" class="mega-menu__promo-img" loading="lazy">
                              <div class="mega-menu__promo-overlay"></div>
                            </div>
                          {%- endif -%}
                          <div class="mega-menu__promo-content">
                            {%- if block_mega_block.settings.promo_badge != blank -%}
                              <span class="mega-menu__promo-tag">{{ block_mega_block.settings.promo_badge }}</span>
                            {%- endif -%}
                            <h4 class="mega-menu__promo-title">{{ block_mega_block.settings.promo_title }}</h4>
                            {%- if block_mega_block.settings.promo_button_text != blank -%}
                              <span class="mega-menu__promo-btn">
                                {{ block_mega_block.settings.promo_button_text }}
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                              </span>
                            {%- endif -%}
                          </div>
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- elsif has_dropdown -%}
              <!-- Standard Dropdown -->
              <div class="header__dropdown">
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}" class="header__dropdown-link">{{ child_link.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <!-- Check if Best Sellers & Sale are already present in nav_links -->
        {%- assign has_bestsellers_in_menu = false -%}
        {%- assign has_sale_in_menu = false -%}
        {%- for link in nav_links -%}
          {%- assign dt = link.title | downcase -%}
          {%- if dt contains 'best' or dt contains 'الأكثر' -%}{%- assign has_bestsellers_in_menu = true -%}{%- endif -%}
          {%- if dt contains 'sale' or dt contains 'تخفيض' or dt contains 'عروض' -%}{%- assign has_sale_in_menu = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_best_sellers and has_bestsellers_in_menu == false -%}
          <div class="header__menu-item">
            <a href="/collections/best-sellers" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}BEST SELLERS{% endif %}</span>
              <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.show_sale and has_sale_in_menu == false -%}
          <div class="header__menu-item header__menu-item--sale">
            <a href="/collections/sale" class="header__menu-link">
              <span>{% if request.locale.iso_code == 'ar' %}تخفيضات{% else %}SALE{% endif %}</span>
              <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </nav>

    <!-- Header Actions (Search, Account, Wishlist, Cart) -->
    <div class="header__right">
      <!-- Language Switcher -->
      {% render 'localization-selector' %}

      <!-- Search Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-search-open
        aria-label="{{ 'sections.header.search' | t | default: 'Search' }}"
      >
        {% render 'icon-search' %}
      </button>

      <!-- Customer Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__icon-btn"
          aria-label="{{ 'sections.header.account' | t | default: 'Account' }}"
        >
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <!-- Wishlist Counter -->
      <button
        type="button"
        class="header__icon-btn"
        data-wishlist-open
        aria-label="{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}"
      >
        {% render 'icon-heart' %}
        <span class="header__wishlist-count" data-wishlist-count style="display: none;">0</span>
      </button>

      <!-- Cart Drawer Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-cart-open
        aria-label="{{ 'sections.header.cart' | t | default: 'Cart' }}"
      >
        {% render 'icon-cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop -->
<div id="MobileNavBackdrop" class="drawer-backdrop" data-mobile-menu-close></div>

<!-- Mobile Navigation Drawer (Synchronized with Main Mega Menu & Multi-Level Accordions) -->
<div id="MobileNavDrawer" class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">
  <div class="mobile-nav-drawer__header">
    <div class="header__logo">
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 36px;">
    </div>
    <button type="button" class="mobile-nav-drawer__close-btn" data-mobile-menu-close aria-label="Close menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="mobile-nav-drawer__body">
    <!-- Mobile Search Bar -->
    <div class="mobile-nav__search-box">
      <button
        type="button"
        class="btn btn-outline btn-full btn-sm"
        data-search-open
        style="justify-content: flex-start; gap: 10px; color: var(--color-foreground-secondary);"
      >
        {% render 'icon-search' %}
        <span>{{ 'general.search.placeholder' | t | default: 'Search collections...' }}</span>
      </button>
    </div>

    <!-- Mobile Navigation Links with Multi-Level Accordions -->
    <div class="mobile-nav__links">
      {%- assign nav_links = linklists[section.settings.menu].links -%}
      {%- assign trigger_name = section.settings.mega_menu_trigger | downcase | strip -%}

      {%- for link in nav_links -%}
        {%- assign downcased_title = link.title | downcase | strip -%}
        
        {%- assign is_mega = false -%}
        {%- if section.settings.enable_mega_menu -%}
          {%- if trigger_name != blank and downcased_title == trigger_name -%}
            {%- assign is_mega = true -%}
          {%- elsif trigger_name == blank or trigger_name == 'catalog' -%}
            {%- if downcased_title contains 'catalog' or downcased_title contains 'shop' or downcased_title contains 'collection' or downcased_title contains 'متجر' or downcased_title contains 'منتجات' or downcased_title contains 'تشكيلات' -%}
              {%- assign is_mega = true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign has_children = false -%}
        {%- if link.links.size > 0 -%}
          {%- assign has_children = true -%}
        {%- endif -%}

        {%- if is_mega -%}
          <!-- Main Mega Menu Accordion in Mobile Drawer -->
          <div class="mobile-nav__item mobile-nav__item--accordion">
            <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
              <span class="mobile-nav__title-wrap">
                <span class="mobile-nav__item-title">{{ link.title }}</span>
              </span>
              <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="mobile-nav__accordion-content">
              <a href="{{ link.url }}" class="mobile-nav__shop-all-link">
                <span>{{ 'sections.header.shop_all' | t | default: 'Shop All' }} {{ link.title }}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>

              {%- if section.settings.mega_menu_linklist != blank and linklists[section.settings.mega_menu_linklist].links.size > 0 -%}
                {%- for col in linklists[section.settings.mega_menu_linklist].links -%}
                  {%- if col.links.size > 0 -%}
                    <div class="mobile-nav__sub-accordion">
                      <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                        <span>{{ col.title }}</span>
                        <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="mobile-nav__sub-accordion-content">
                        {%- for sub in col.links -%}
                          <a href="{{ sub.url }}" class="mobile-nav__sub-link">{{ sub.title }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <a href="{{ col.url }}" class="mobile-nav__child-link">{{ col.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif link.links.size > 0 -%}
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    <div class="mobile-nav__sub-accordion">
                      <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                        <span>{{ child.title }}</span>
                        <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="mobile-nav__sub-accordion-content">
                        {%- for sub in child.links -%}
                          <a href="{{ sub.url }}" class="mobile-nav__sub-link">{{ sub.title }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <!-- Default Streetwear Categories Sub-Accordions -->
                <!-- Men -->
                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% if request.locale.iso_code == 'ar' %}رجالي (Men){% else %}Men's Streetwear{% endif %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/men" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">{% if request.locale.iso_code == 'ar' %}تسوق كل تشكيلة الرجال &larr;{% else %}Shop All Men &rarr;{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات أوفر سايز (Oversized){% else %}Oversized T-Shirts{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات جرافيك وطباعة{% else %}Graphic & Printed Tees{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز وسويت شيرت سميك{% else %}Heavyweight Hoodies{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بنطلونات كارجو وسويت بانتس{% else %}Tactical Cargo & Pants{% endif %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أطقم قطعتين وترينجات{% else %}Matching Sets & Tracksuits{% endif %}</a>
                  </div>
                </div>

                <!-- Women -->
                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% if request.locale.iso_code == 'ar' %}حريمي (Women){% else %}Women's Collection{% endif %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/women" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">{% if request.locale.iso_code == 'ar' %}تسوق كل تشكيلة النساء &larr;{% else %}Shop All Women &rarr;{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}توبات وتيشيرتات واسعة{% else %}Cropped & Oversized Tops{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز وسويت شيرت مريح{% else %}Minimalist Lounge Hoodies{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}بنطلونات واسعة وكارجو{% else %}Wide-Leg Pants & Cargo{% endif %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أطقم ملابس مريحة Loungewear{% else %}Comfort Matching Sets{% endif %}</a>
                  </div>
                </div>

                <!-- Kids & Teens -->
                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% if request.locale.iso_code == 'ar' %}أطفال وناشئين (Kids){% else %}Kids & Teens{% endif %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/kids" class="mobile-nav__sub-link" style="font-weight: 700; color: var(--color-primary);">{% if request.locale.iso_code == 'ar' %}تسوق كل تشكيلة الأطفال &larr;{% else %}Shop All Kids &rarr;{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}تيشيرتات جرافيك أولاد{% else %}Boys Graphic Tees{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}ملابس كاجوال بنات{% else %}Girls Casual & Tops{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}هوديز وترينجات أطفال{% else %}Kids Hoodies & Sweats{% endif %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% if request.locale.iso_code == 'ar' %}أساسيات المراهقين والناشئين{% else %}Teen Streetwear Essentials{% endif %}</a>
                  </div>
                </div>
              {%- endif -%}

              <!-- Mobile Promo Card inside Accordion -->
              {%- if section.settings.show_promo_banner -%}
                <div style="margin-top: 14px; padding: 14px; background: var(--color-bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);">
                  {%- if section.settings.promo_badge != blank -%}
                    <span class="mega-menu__promo-tag" style="margin-bottom: 6px;">{{ section.settings.promo_badge }}</span>
                  {%- endif -%}
                  <strong style="display: block; font-size: 0.95rem; margin-bottom: 6px; color: var(--color-foreground);">{{ section.settings.promo_title | default: 'Never Mind Streetwear Drop' }}</strong>
                  <a href="{{ section.settings.promo_url | default: '/collections/all' }}" class="btn btn-primary btn-sm btn-full" style="margin-top: 8px;">
                    {{ section.settings.promo_btn | default: 'Shop Now' }} &rarr;
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>

        {%- elsif has_children -%}
          <!-- Regular Dropdown Accordion -->
          <div class="mobile-nav__item mobile-nav__item--accordion">
            <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
              <span class="mobile-nav__title-wrap">
                <span class="mobile-nav__item-title">{{ link.title }}</span>
              </span>
              <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="mobile-nav__accordion-content">
              {%- for child in link.links -%}
                <a href="{{ child.url }}" class="mobile-nav__child-link">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <!-- Direct Single Link -->
          <div class="mobile-nav__item">
            <a href="{{ link.url }}" class="mobile-nav__item-link">
              <span>{{ link.title }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Standalone Best Sellers & Sale if not in menu -->
      {%- if section.settings.show_best_sellers and has_bestsellers_in_menu == false -%}
        <div class="mobile-nav__item">
          <a href="/collections/best-sellers" class="mobile-nav__item-link">
            <span>{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}BEST SELLERS{% endif %}</span>
            <span class="nav-badge nav-badge--hot">{{ 'sections.header.hot' | t | default: 'HOT' }}</span>
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.show_sale and has_sale_in_menu == false -%}
        <div class="mobile-nav__item">
          <a href="/collections/sale" class="mobile-nav__item-link" style="color: var(--color-sale);">
            <span>{% if request.locale.iso_code == 'ar' %}تخفيضات{% else %}SALE{% endif %}</span>
            <span class="nav-badge nav-badge--sale">{{ 'sections.header.sale' | t | default: 'SALE' }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Mobile Bottom Utilities (Account, Wishlist, Egypt COD Guarantee) -->
    <div class="mobile-nav__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav__footer-link">
          {% render 'icon-account' %}
          <span>{% if customer %}{{ 'customer.account.title' | t | default: 'My Account' }}{% else %}{{ 'customer.login_page.sign_in' | t | default: 'Sign In / Register' }}{% endif %}</span>
        </a>
      {%- endif -%}

      <a href="/pages/wishlist" class="mobile-nav__footer-link" data-wishlist-open>
        {% render 'icon-heart' %}
        <span>{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}</span>
        <span class="badge" data-wishlist-count style="display: none; margin-inline-start: auto;">0</span>
      </a>

      <div class="mobile-nav__trust-badge">
        <div class="mobile-nav__trust-icon">🇪🇬</div>
        <div>
          <strong>Never Mind Egypt</strong><br>
          <span style="font-size: 0.8rem; color: var(--color-foreground-secondary);">
            {% if request.locale.iso_code == 'ar' %}
              دفع عند الاستلام • معاينة الشحنة قبل الدفع
            {% else %}
              Cash on Delivery Available • Inspect Before Paying
            {% endif %}
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Store Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Custom Logo Width",
      "default": 140
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu",
      "info": "Online Store > Navigation > Main menu"
    },
    {
      "type": "header",
      "content": "Main Mega Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_mega_menu",
      "label": "Enable Main Mega Menu",
      "default": true,
      "info": "Displays a multi-column mega menu with sub-collections and promotional banner card on desktop."
    },
    {
      "type": "text",
      "id": "mega_menu_trigger",
      "label": "Menu Item to Open Mega Menu",
      "default": "Catalog",
      "info": "Name of the link in your Main Menu that opens this mega menu (e.g. Catalog, Shop, Collections, or المتجر)."
    },
    {
      "type": "link_list",
      "id": "mega_menu_linklist",
      "label": "Custom Mega Menu Columns Menu (Optional)",
      "info": "Select a menu with child links to customize the columns. If left blank, default streetwear categories (Men, Women, Kids, Trending) are displayed."
    },
    {
      "type": "header",
      "content": "Mega Menu Promotional Banner"
    },
    {
      "type": "checkbox",
      "id": "show_promo_banner",
      "label": "Show Promotional Banner Card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promotional Banner Image"
    },
    {
      "type": "text",
      "id": "promo_badge",
      "label": "Promo Badge Pill Text",
      "default": "NEW DROP 2026"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Promotional Heading",
      "default": "Never Mind Streetwear Drop"
    },
    {
      "type": "url",
      "id": "promo_url",
      "label": "Promotional Destination Link"
    },
    {
      "type": "text",
      "id": "promo_btn",
      "label": "Promotional Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Featured Quick Links"
    },
    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show Best Sellers Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale",
      "label": "Show Sale Link (Highlighted)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Custom Mega Menu Block",
      "settings": [
        {
          "type": "text",
          "id": "trigger_title",
          "label": "Menu Item Title",
          "info": "Name of the link in the header navigation (e.g. Accessories, Hoodies, Summer Drop)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Columns Menu Linklist",
          "info": "Select a menu with child links to display as columns."
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "promo_badge",
          "label": "Badge Pill Text",
          "default": "HOT"
        },
        {
          "type": "text",
          "id": "promo_title",
          "label": "Promotional Heading",
          "default": "Featured Drop"
        },
        {
          "type": "url",
          "id": "promo_url",
          "label": "Banner Destination Link"
        },
        {
          "type": "text",
          "id": "promo_button_text",
          "label": "Button Label",
          "default": "Shop Now"
        }
      ]
    }
  ]
}
{% endschema %}
