<header class="header-wrapper" id="site-header">
  <div class="container header">
    <!-- Mobile Hamburger Toggle -->
    <div class="header__left">
      <button
        type="button"
        class="header__mobile-toggle"
        data-mobile-menu-toggle
        aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}"
        aria-controls="MobileNavDrawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            width="{{ section.settings.logo_width }}"
          >
        {%- else -%}
          <img
            src="{{ 'logo.svg' | asset_url }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            style="height: {{ section.settings.logo_width | divided_by: 3 | default: 42 }}px;"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Main Navigation (Menu & Sub-Menus) -->
    <nav class="header__nav" aria-label="{{ 'accessibility.main_navigation' | t | default: 'Main Navigation' }}">
      {%- assign nav_menu = section.settings.menu -%}
      {%- assign nav_links = nav_menu.links -%}
      {%- if nav_links == blank or nav_links.size == 0 -%}
        {%- assign nav_links = linklists[nav_menu].links -%}
      {%- endif -%}
      {%- if nav_links == blank or nav_links.size == 0 -%}
        {%- assign nav_links = linklists['main-menu'].links -%}
      {%- endif -%}

      {%- if nav_links.size > 0 -%}
        <ul class="header__menu-list" role="menubar">
          {%- for link in nav_links -%}
            {%- assign downcased_title = link.title | downcase | strip -%}
            {%- assign has_dropdown = false -%}
            {%- assign is_catalog_fallback = false -%}

            {%- if link.links.size > 0 -%}
              {%- assign has_dropdown = true -%}
            {%- elsif downcased_title contains 'catalog' or downcased_title contains 'shop' or downcased_title contains 'collection' or downcased_title contains 'متجر' or downcased_title contains 'منتجات' or downcased_title contains 'تشكيلات' -%}
              {%- assign has_dropdown = true -%}
              {%- assign is_catalog_fallback = true -%}
            {%- endif -%}

            <li class="header__menu-item{% if has_dropdown %} header__menu-item--has-dropdown{% endif %}{% if link.active %} is-active{% endif %}" role="none">
              <a
                href="{{ link.url }}"
                class="header__menu-link"
                role="menuitem"
                {% if has_dropdown %}
                  aria-haspopup="true"
                  aria-expanded="false"
                {% endif %}
              >
                <span>{% render 'translate-nav', text: link.title %}</span>
                {%- if has_dropdown -%}
                  <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                {%- endif -%}
              </a>

              {%- if has_dropdown -%}
                <!-- Standard Dropdown with Sub-Menus -->
                <ul class="header__dropdown" role="menu" aria-label="{{ link.title }}">
                  {%- if link.links.size > 0 -%}
                    {%- for child_link in link.links -%}
                      {%- assign has_submenu = false -%}
                      {%- if child_link.links.size > 0 -%}
                        {%- assign has_submenu = true -%}
                      {%- endif -%}

                      <li class="header__dropdown-item{% if has_submenu %} header__dropdown-item--has-submenu{% endif %}" role="none">
                        <a
                          href="{{ child_link.url }}"
                          class="header__dropdown-link{% if has_submenu %} header__dropdown-link--parent{% endif %}{% if child_link.active %} is-active{% endif %}"
                          role="menuitem"
                          {% if has_submenu %}
                            aria-haspopup="true"
                            aria-expanded="false"
                          {% endif %}
                        >
                          <span>{% render 'translate-nav', text: child_link.title %}</span>
                          {%- if has_submenu -%}
                            <svg class="header__submenu-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                          {%- endif -%}
                        </a>

                        {%- if has_submenu -%}
                          <ul class="header__submenu" role="menu" aria-label="{{ child_link.title }}">
                            {%- for grandchild_link in child_link.links -%}
                              <li class="header__submenu-item" role="none">
                                <a href="{{ grandchild_link.url }}" class="header__submenu-link{% if grandchild_link.active %} is-active{% endif %}" role="menuitem">
                                  <span>{% render 'translate-nav', text: grandchild_link.title %}</span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  {%- elsif is_catalog_fallback -%}
                    <!-- Curated Categories Dropdown with Sub-Menus -->
                    <li class="header__dropdown-item header__dropdown-item--has-submenu" role="none">
                      <a href="/collections/men" class="header__dropdown-link header__dropdown-link--parent" role="menuitem" aria-haspopup="true" aria-expanded="false">
                        <span>{% render 'translate-nav', text: "Men's Streetwear" %}</span>
                        <svg class="header__submenu-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                      <ul class="header__submenu" role="menu" aria-label="Men's Streetwear">
                        <li class="header__submenu-item" role="none"><a href="/collections/men" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Oversized T-Shirts' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/men" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Graphic & Printed Tees' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/men" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Heavyweight Hoodies' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/men" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Tactical Cargo & Pants' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/men" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Matching Sets & Tracksuits' %}</span></a></li>
                      </ul>
                    </li>

                    <li class="header__dropdown-item header__dropdown-item--has-submenu" role="none">
                      <a href="/collections/women" class="header__dropdown-link header__dropdown-link--parent" role="menuitem" aria-haspopup="true" aria-expanded="false">
                        <span>{% render 'translate-nav', text: "Women's Collection" %}</span>
                        <svg class="header__submenu-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                      <ul class="header__submenu" role="menu" aria-label="Women's Collection">
                        <li class="header__submenu-item" role="none"><a href="/collections/women" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Cropped & Oversized Tops' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/women" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Minimalist Lounge Hoodies' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/women" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Wide-Leg Pants & Cargo' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/women" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Comfort Matching Sets' %}</span></a></li>
                      </ul>
                    </li>

                    <li class="header__dropdown-item header__dropdown-item--has-submenu" role="none">
                      <a href="/collections/kids" class="header__dropdown-link header__dropdown-link--parent" role="menuitem" aria-haspopup="true" aria-expanded="false">
                        <span>{% render 'translate-nav', text: 'Kids & Teens' %}</span>
                        <svg class="header__submenu-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                      <ul class="header__submenu" role="menu" aria-label="Kids & Teens">
                        <li class="header__submenu-item" role="none"><a href="/collections/kids" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Boys Graphic Tees' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/kids" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Girls Casual & Tops' %}</span></a></li>
                        <li class="header__submenu-item" role="none"><a href="/collections/kids" class="header__submenu-link" role="menuitem"><span>{% render 'translate-nav', text: 'Kids Hoodies & Sweats' %}</span></a></li>
                      </ul>
                    </li>

                    <li class="header__dropdown-item" role="none">
                      <a href="/collections/best-sellers" class="header__dropdown-link" role="menuitem">
                        <span>{% render 'translate-nav', text: 'Top Best Sellers 🔥' %}</span>
                      </a>
                    </li>

                    <li class="header__dropdown-item" role="none">
                      <a href="/collections/all" class="header__dropdown-link" role="menuitem">
                        <span>{% render 'translate-nav', text: 'Browse All Collections →' %}</span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <!-- Header Actions (Search, Account, Wishlist, Cart) -->
    <div class="header__right">
      <!-- Language Switcher -->
      {% render 'localization-selector' %}

      <!-- Search Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-search-open
        aria-label="{{ 'sections.header.search' | t | default: 'Search' }}"
      >
        {% render 'icon-search' %}
      </button>

      <!-- Customer Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__icon-btn"
          aria-label="{{ 'sections.header.account' | t | default: 'Account' }}"
        >
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <!-- Wishlist Counter -->
      <button
        type="button"
        class="header__icon-btn"
        data-wishlist-open
        aria-label="{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}"
      >
        {% render 'icon-heart' %}
        <span class="header__wishlist-count" data-wishlist-count style="display: none;">0</span>
      </button>

      <!-- Cart Drawer Trigger -->
      <button
        type="button"
        class="header__icon-btn"
        data-cart-open
        aria-label="{{ 'sections.header.cart' | t | default: 'Cart' }}"
      >
        {% render 'icon-cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop -->
<div id="MobileNavBackdrop" class="drawer-backdrop" data-mobile-menu-close></div>

<!-- Mobile Navigation Drawer (Synchronized with Main Mega Menu & Multi-Level Accordions) -->
<div id="MobileNavDrawer" class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">
  <div class="mobile-nav-drawer__header">
    <span class="mobile-nav-drawer__title">{{ 'sections.header.menu' | t }}</span>
    <button type="button" class="mobile-nav-drawer__close-btn" data-mobile-menu-close aria-label="{{ 'sections.header.close_menu' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <div class="mobile-nav-drawer__body">
    <!-- Mobile Search Bar -->
    <div class="mobile-nav__search-box">
      <button
        type="button"
        class="btn btn-outline btn-full btn-sm"
        data-search-open
        style="justify-content: flex-start; gap: 10px; color: var(--color-foreground-secondary);"
      >
        {% render 'icon-search' %}
        <span>{{ 'general.search.placeholder' | t | default: 'Search collections...' }}</span>
      </button>
    </div>

    <!-- Mobile Navigation Links with Multi-Level Accordions -->
    <div class="mobile-nav__links">
      {%- assign nav_menu = section.settings.menu -%}
      {%- assign nav_links = nav_menu.links -%}
      {%- if nav_links == blank or nav_links.size == 0 -%}
        {%- assign nav_links = linklists[nav_menu].links -%}
      {%- endif -%}
      {%- if nav_links == blank or nav_links.size == 0 -%}
        {%- assign nav_links = linklists['main-menu'].links -%}
      {%- endif -%}
      {%- assign is_rtl = false -%}
      {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}{%- assign is_rtl = true -%}{%- endif -%}

      {%- for link in nav_links -%}
        {%- assign downcased_title = link.title | downcase | strip -%}
        {%- assign has_dropdown = false -%}
        {%- assign is_catalog_fallback = false -%}

        {%- if link.links.size > 0 -%}
          {%- assign has_dropdown = true -%}
        {%- elsif downcased_title contains 'catalog' or downcased_title contains 'shop' or downcased_title contains 'collection' or downcased_title contains 'متجر' or downcased_title contains 'منتجات' or downcased_title contains 'تشكيلات' -%}
          {%- assign has_dropdown = true -%}
          {%- assign is_catalog_fallback = true -%}
        {%- endif -%}

        {%- if has_dropdown -%}
          <!-- Mobile Accordion Menu -->
          <div class="mobile-nav__item mobile-nav__item--accordion">
            <button type="button" class="mobile-nav__accordion-header" data-mobile-accordion-trigger aria-expanded="false">
              <span class="mobile-nav__title-wrap">
                <span class="mobile-nav__item-title">{% render 'translate-nav', text: link.title %}</span>
              </span>
              <svg class="mobile-nav__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="mobile-nav__accordion-content">
              {%- if link.url != blank and link.url != '#' -%}
                <a href="{{ link.url }}" class="mobile-nav__shop-all-link">
                  <span>{{ 'collections.general.all_of_collection' | t: collection: link.title | default: 'Shop All' }}</span>
                  <span aria-hidden="true">{% if is_rtl %}&larr;{% else %}&rarr;{% endif %}</span>
                </a>
              {%- endif -%}

              {%- if link.links.size > 0 -%}
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    <!-- Level 2 Sub-Accordion -->
                    <div class="mobile-nav__sub-accordion">
                      <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                        <span>{% render 'translate-nav', text: child.title %}</span>
                        <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="mobile-nav__sub-accordion-content">
                        {%- if child.url != blank and child.url != '#' -%}
                          <a href="{{ child.url }}" class="mobile-nav__sub-link" style="font-weight: 600;">
                            {{ 'collections.general.all_of_collection' | t: collection: child.title | default: 'All' }}
                          </a>
                        {%- endif -%}
                        {%- for grandchild in child.links -%}
                          <a href="{{ grandchild.url }}" class="mobile-nav__sub-link">
                            {% render 'translate-nav', text: grandchild.title %}
                          </a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <!-- Single Child Link -->
                    <a href="{{ child.url }}" class="mobile-nav__child-link">
                      {% render 'translate-nav', text: child.title %}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif is_catalog_fallback -%}
                <!-- Curated Mobile Sub-Accordions -->
                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% render 'translate-nav', text: "Men's Streetwear" %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/men" class="mobile-nav__sub-link" style="font-weight: 600;">Shop All Men's &rarr;</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Oversized T-Shirts' %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Graphic & Printed Tees' %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Heavyweight Hoodies' %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Tactical Cargo & Pants' %}</a>
                    <a href="/collections/men" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Matching Sets & Tracksuits' %}</a>
                  </div>
                </div>

                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% render 'translate-nav', text: "Women's Collection" %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/women" class="mobile-nav__sub-link" style="font-weight: 600;">Shop All Women's &rarr;</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Cropped & Oversized Tops' %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Minimalist Lounge Hoodies' %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Wide-Leg Pants & Cargo' %}</a>
                    <a href="/collections/women" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Comfort Matching Sets' %}</a>
                  </div>
                </div>

                <div class="mobile-nav__sub-accordion">
                  <button type="button" class="mobile-nav__sub-accordion-header" data-mobile-sub-accordion-trigger aria-expanded="false">
                    <span>{% render 'translate-nav', text: 'Kids & Teens' %}</span>
                    <svg class="mobile-nav__sub-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="mobile-nav__sub-accordion-content">
                    <a href="/collections/kids" class="mobile-nav__sub-link" style="font-weight: 600;">Shop All Kids &rarr;</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Boys Graphic Tees' %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Girls Casual & Tops' %}</a>
                    <a href="/collections/kids" class="mobile-nav__sub-link">{% render 'translate-nav', text: 'Kids Hoodies & Sweats' %}</a>
                  </div>
                </div>

                <a href="/collections/best-sellers" class="mobile-nav__child-link">{% render 'translate-nav', text: 'Top Best Sellers 🔥' %}</a>
                <a href="/collections/all" class="mobile-nav__child-link">{% render 'translate-nav', text: 'Browse All Collections →' %}</a>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <!-- Single Top-Level Link -->
          <div class="mobile-nav__item">
            <a href="{{ link.url }}" class="mobile-nav__single-link">
              <span>{% render 'translate-nav', text: link.title %}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Mobile Bottom Utilities (Account, Wishlist, Egypt COD Guarantee) -->
    <div class="mobile-nav__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav__footer-link">
          {% render 'icon-account' %}
          <span>{% if customer %}{{ 'customer.account.title' | t | default: 'My Account' }}{% else %}{{ 'customer.login_page.sign_in' | t | default: 'Sign In / Register' }}{% endif %}</span>
        </a>
      {%- endif -%}

      <a href="/pages/wishlist" class="mobile-nav__footer-link" data-wishlist-open>
        {% render 'icon-heart' %}
        <span>{{ 'sections.header.wishlist' | t | default: 'Wishlist' }}</span>
        <span class="badge" data-wishlist-count style="display: none; margin-inline-start: auto;">0</span>
      </a>

      <div class="mobile-nav__trust-badge">
        <div class="mobile-nav__trust-icon">🇪🇬</div>
        <div>
          <strong>{{ 'sections.header.brand_tagline' | t }}</strong><br>
          <span style="font-size: 0.8rem; color: var(--color-foreground-secondary);">
            {{ 'sections.header.cod_badge' | t }} • {{ 'sections.header.courier_try_badge' | t }}
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Store Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Custom Logo Width",
      "default": 140
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu",
      "info": "Online Store > Navigation > Main menu"
    }
  ]
}
{% endschema %}
