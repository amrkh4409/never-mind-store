<section class="recently-viewed-section" style="padding: 60px 0; border-top: 1px solid var(--color-border-light);">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-header__title">{{ section.settings.heading | default: "Recently Viewed" }}</h2>
        <p class="section-header__subtitle">Items you recently browsed</p>
      </div>
    </div>

    <div id="RecentlyViewedContainer" class="products-grid">
      {%- comment -%} Populated dynamically by theme.js {%- endcomment -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}
