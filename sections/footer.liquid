<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Mission Column -->
      <div class="footer-col">
        <div class="header__logo" style="margin-bottom: 14px;">
          {%- if section.settings.footer_logo != blank -%}
            <img src="{{ section.settings.footer_logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="height: 38px;">
          {%- else -%}
            <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 38px;">
          {%- endif -%}
        </div>
        <p style="font-size: 0.9rem; color: var(--color-foreground-secondary); line-height: 1.6; margin-bottom: 20px; max-width: 320px;">
          {{ section.settings.brand_text | default: "Contemporary Egyptian luxury streetwear and minimalist fashion designed with premium fabrics and tailored cuts." }}
        </p>
        
        <!-- Social Icons -->
        <div style="display: flex; align-items: center; gap: 14px;">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" style="color: var(--color-foreground);" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" style="color: var(--color-foreground);" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" style="color: var(--color-foreground);" aria-label="TikTok">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.92 3.5 2.7 1.48-.1 2.71-1.09 3.1-2.52.2-.61.26-1.25.24-1.89l.05-14.86z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Shop Menu -->
      <div class="footer-col">
        <h4 class="footer-col__title">{{ section.settings.shop_menu_title | default: "Shop Collections" }}</h4>
        <ul class="footer-links">
          {%- for link in linklists[section.settings.shop_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="/collections/all">All Products</a></li>
            <li><a href="/collections/men">Men</a></li>
            <li><a href="/collections/women">Women</a></li>
            <li><a href="/collections/new-arrivals">New Arrivals</a></li>
            <li><a href="/collections/sale">Sale</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Customer Service Menu -->
      <div class="footer-col">
        <h4 class="footer-col__title">{{ section.settings.support_menu_title | default: "Customer Service" }}</h4>
        <ul class="footer-links">
          {%- for link in linklists[section.settings.support_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/shipping-delivery">Shipping & Governorates</a></li>
            <li><a href="/pages/returns-exchange">14-Day Exchange & Returns</a></li>
            <li><a href="#" data-size-guide-open>Size Guide</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div class="footer-col">
        <h4 class="footer-col__title">{{ 'general.newsletter.title' | t }}</h4>
        <p style="font-size: 0.88rem; color: var(--color-foreground-secondary); margin-bottom: 16px;">
          {{ 'general.newsletter.subtitle' | t }}
        </p>

        {%- form 'customer', id: 'FooterNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p style="font-size: 0.85rem; color: var(--color-success); font-weight: 600;">{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <div style="display: flex; gap: 8px;">
              <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                required
                style="flex: 1; padding: 12px 14px; font-size: 0.88rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-bg);"
              >
              <button type="submit" class="btn btn-primary btn-sm" style="flex-shrink: 0;">
                {{ 'general.newsletter.button_label' | t }}
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}

        <!-- Egyptian Trust Badges in Footer -->
        <div style="margin-top: 20px; display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--color-foreground-secondary);">
          {% render 'icon-shield' %}
          <span>Cash on Delivery Available Across All Egypt</span>
        </div>
      </div>
    </div>

    <!-- Footer Bottom: Payment & Copyright -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.copyright' | t }}
      </div>
      <div style="display: flex; align-items: center; gap: 12px; font-size: 0.82rem; font-weight: 600;">
        <span class="badge badge-cod">💵 Cash on Delivery</span>
        <span class="badge badge-cod">💳 Visa / Mastercard</span>
        <span class="badge badge-cod">🇪🇬 Meeza / ValU</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand Mission Text",
      "default": "Contemporary Egyptian luxury streetwear and minimalist fashion designed with premium fabrics and tailored cuts."
    },
    {
      "type": "text",
      "id": "shop_menu_title",
      "label": "Shop Menu Title",
      "default": "Shop Collections"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "support_menu_title",
      "label": "Support Menu Title",
      "default": "Customer Service"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support Menu"
    }
  ]
}
{% endschema %}
