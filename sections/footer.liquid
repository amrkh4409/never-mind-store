<footer class="footer">
  <div class="container">
    {%- assign is_ar = false -%}
    {%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
      {%- assign is_ar = true -%}
    {%- endif -%}

    <div class="footer-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                <div class="header__logo" style="margin-bottom: 14px;">
                  {%- if block.settings.logo != blank -%}
                    <img src="{{ block.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="height: 38px; object-fit: contain;">
                  {%- else -%}
                    <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 38px;">
                  {%- endif -%}
                </div>

                <p style="font-size: 0.9rem; color: var(--color-foreground-secondary); line-height: 1.6; margin-bottom: 20px; max-width: 320px;">
                  {%- if block.settings.text == blank or block.settings.text == 'Contemporary Egyptian luxury streetwear and minimalist fashion designed with premium fabrics and tailored cuts.' -%}
                    {{ 'sections.footer.brand_bio' | t }}
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </p>

                {%- if block.settings.show_social -%}
                  {% render 'social-icons', block: block %}
                {%- endif -%}
              </div>

            {%- when 'link_list' -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                {%- assign col_heading = block.settings.heading -%}
                {%- if col_heading == 'Shop Collections' or col_heading == blank -%}
                  {%- assign col_heading = 'sections.footer.shop_collections' | t -%}
                {%- elsif col_heading == 'Customer Service' -%}
                  {%- assign col_heading = 'sections.footer.customer_service' | t -%}
                {%- endif -%}
                <h4 class="footer-col__title">{{ col_heading }}</h4>
                <ul class="footer-links">
                  {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  {%- else -%}
                    <li><a href="/collections/all">{{ 'collections.general.all_collections' | t }}</a></li>
                    <li><a href="/collections/men">{{ 'sections.mega_menu.category_1_title' | t }}</a></li>
                    <li><a href="/collections/women">{{ 'sections.mega_menu.category_2_title' | t }}</a></li>
                    <li><a href="/collections/kids">{{ 'sections.mega_menu.category_3_title' | t }}</a></li>
                    <li><a href="/collections/best-sellers">{{ 'collections.sorting.best_selling' | t }}</a></li>
                    <li><a href="/collections/sale">{{ 'sections.header.sale' | t }}</a></li>
                  {%- endif -%}
                </ul>
              </div>

            {%- when 'text' -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                <h4 class="footer-col__title">{{ block.settings.heading }}</h4>
                <div style="font-size: 0.9rem; color: var(--color-foreground-secondary); line-height: 1.6;">
                  {{ block.settings.subtext }}
                </div>
              </div>

            {%- when 'newsletter' -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                {%- assign n_heading = block.settings.heading -%}
                {%- if n_heading == blank or n_heading == 'Subscribe to our VIP list' or n_heading == 'Subscribe' -%}
                  {%- assign n_heading = 'general.newsletter.title' | t -%}
                {%- endif -%}
                <h4 class="footer-col__title">{{ n_heading }}</h4>
                <p style="font-size: 0.88rem; color: var(--color-foreground-secondary); margin-bottom: 16px;">
                  {%- if block.settings.subtext == blank or block.settings.subtext == 'Get early access to fresh drops and exclusive Egyptian cotton streetwear promotions.' -%}
                    {{ 'general.newsletter.subtitle' | t }}
                  {%- else -%}
                    {{ block.settings.subtext }}
                  {%- endif -%}
                </p>

                {%- form 'customer', id: 'FooterNewsletterForm' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p style="font-size: 0.85rem; color: var(--color-success); font-weight: 600;">{{ 'general.newsletter.success' | t }}</p>
                  {%- else -%}
                    <div style="display: flex; gap: 8px;">
                      <input
                        type="email"
                        name="contact[email]"
                        value="{{ form.email }}"
                        placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                        required
                        style="flex: 1; padding: 12px 14px; font-size: 0.88rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-bg);"
                      >
                      <button type="submit" class="btn btn-primary btn-sm" style="flex-shrink: 0;">
                        {{ 'general.newsletter.button_label' | t }}
                      </button>
                    </div>
                  {%- endif -%}
                {%- endform -%}

                {%- if block.settings.show_cod_note -%}
                  <div style="margin-top: 20px; display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--color-foreground-secondary);">
                    {% render 'icon-shield' %}
                    <span>
                      {{ 'sections.footer.cod_inspection' | t }}
                    </span>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'social' -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                {%- assign s_heading = block.settings.heading -%}
                {%- if s_heading != blank -%}
                  <h4 class="footer-col__title">{{ s_heading }}</h4>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p style="font-size: 0.9rem; color: var(--color-foreground-secondary); line-height: 1.6; margin-bottom: 16px;">
                    {{ block.settings.subtext }}
                  </p>
                {%- endif -%}
                {% render 'social-icons', block: block %}
              </div>

          {%- endcase -%}
        {%- endfor -%}

      {%- else -%}
        <!-- Default 4-Column Layout when no blocks are defined -->
        <div class="footer-col">
          <div class="header__logo" style="margin-bottom: 14px;">
            <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 38px;">
          </div>
          <p style="font-size: 0.9rem; color: var(--color-foreground-secondary); line-height: 1.6; margin-bottom: 20px; max-width: 320px;">
            {{ 'sections.footer.brand_bio' | t }}
          </p>
          {% render 'social-icons' %}
        </div>

        <div class="footer-col">
          <h4 class="footer-col__title">{{ 'sections.footer.shop_collections' | t }}</h4>
          <ul class="footer-links">
            <li><a href="/collections/all">{{ 'collections.general.all_collections' | t }}</a></li>
            <li><a href="/collections/men">{{ 'sections.mega_menu.category_1_title' | t }}</a></li>
            <li><a href="/collections/women">{{ 'sections.mega_menu.category_2_title' | t }}</a></li>
            <li><a href="/collections/kids">{{ 'sections.mega_menu.category_3_title' | t }}</a></li>
            <li><a href="/collections/best-sellers">{{ 'collections.sorting.best_selling' | t }}</a></li>
            <li><a href="/collections/sale">{{ 'sections.header.sale' | t }}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col__title">{{ 'sections.footer.customer_service' | t }}</h4>
          <ul class="footer-links">
            <li><a href="/pages/contact">{{ 'sections.contact.title' | t }}</a></li>
            <li><a href="/pages/faq">{{ 'sections.footer.faq' | t }}</a></li>
            <li><a href="#" data-size-guide-open>{{ 'products.product.size_guide' | t }}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col__title">{{ 'general.newsletter.title' | t }}</h4>
          <p style="font-size: 0.88rem; color: var(--color-foreground-secondary); margin-bottom: 16px;">
            {{ 'general.newsletter.subtitle' | t }}
          </p>
          {%- form 'customer', id: 'FooterNewsletterFormDefault' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display: flex; gap: 8px;">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                required
                style="flex: 1; padding: 12px 14px; font-size: 0.88rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-bg);"
              >
              <button type="submit" class="btn btn-primary btn-sm" style="flex-shrink: 0;">
                {{ 'general.newsletter.button_label' | t }}
              </button>
            </div>
          {%- endform -%}
          <div style="margin-top: 20px; display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--color-foreground-secondary);">
            {% render 'icon-shield' %}
            <span>
              {{ 'sections.footer.cod_inspection' | t }}
            </span>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Footer Bottom: Payment & Copyright -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text }}
        {%- else -%}
          {{ 'sections.footer.copyright' | t }}
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_cod -%}
        <div style="display: flex; align-items: center; gap: 12px; font-size: 0.85rem; font-weight: 600;">
          <span class="badge badge-cod">
            💵 {{ 'sections.footer.payment_cod' | t }}
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

