<div class="container" style="padding-top: 40px; padding-bottom: 80px;">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="margin-bottom: 8px;">{{ collection.title | default: "Catalog" }}</h1>
    {%- if collection.description != blank -%}
      <p style="color: var(--color-foreground-secondary); font-size: 1rem;">{{ collection.description }}</p>
    {%- endif -%}
  </div>

  {%- if collection.products.size > 0 -%}
    <div class="products-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
      {%- for product in collection.products -%}
        {% render 'product-card', product_card_product: product, show_vendor: true %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div style="text-align: center; padding: 60px 16px;">
      <h3>No products found</h3>
      <p style="color: var(--color-foreground-secondary); margin-top: 8px;">Check back soon for new arrivals.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection Products",
  "settings": []
}
{% endschema %}
