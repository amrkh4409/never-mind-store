<div class="container" style="padding-top: 48px; padding-bottom: 80px; max-width: 800px;">
  <span style="font-size: 0.85rem; color: var(--color-foreground-secondary); display: block; margin-bottom: 8px;">
    {{ article.published_at | date: '%B %d, %Y' }} • {{ article.author }}
  </span>
  <h1 style="margin-bottom: 24px;">{{ article.title }}</h1>

  {%- if article.image -%}
    <div style="aspect-ratio: 16/9; border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 32px;">
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
  {%- endif -%}

  <div style="line-height: 1.8; font-size: 1.05rem; color: var(--color-foreground);">
    {{ article.content }}
  </div>

  <div style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--color-border);">
    <a href="{{ blog.url }}" class="btn btn-outline btn-sm">&larr; Back to {{ blog.title }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Article Section",
  "settings": []
}
{% endschema %}
