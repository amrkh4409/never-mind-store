<div class="container" style="padding-top: 48px; padding-bottom: 80px;">
  <div style="max-width: 640px; margin: 0 auto 40px; text-align: center;">
    <h1 style="margin-bottom: 20px;">{{ 'general.search.search' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <div style="display: flex; gap: 8px;">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          style="flex: 1; padding: 14px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 1rem;"
        >
        <button type="submit" class="btn btn-primary btn-sm" style="padding: 0 24px;">
          {{ 'general.search.submit' | t }}
        </button>
      </div>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      {%- if search.results_count == 0 -%}
        <div style="text-align: center; padding: 48px 16px;">
          <p style="font-size: 1.1rem; color: var(--color-foreground-secondary);">
            {{ 'general.search.no_results_html' | t: terms: search.terms }}
          </p>
        </div>
      {%- else -%}
        <div style="margin-bottom: 24px; font-weight: 600; color: var(--color-foreground-secondary);">
          {{ 'general.search.results_with_count.other' | t: count: search.results_count }}
        </div>

        <div class="products-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product_card_product: item, show_vendor: true %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div style="display: flex; justify-content: center; gap: 12px; margin-top: 48px;">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm">&larr; {{ 'general.pagination.previous' | t }}</a>
            {%- endif -%}
            <span>{{ 'general.pagination.current_page' | t: current: paginate.current_page, total: paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="btn btn-outline btn-sm">{{ 'general.pagination.next' | t }} &rarr;</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
