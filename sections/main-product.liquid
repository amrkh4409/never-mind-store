{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign discount_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

<section class="product-main-section" data-variant-picker data-section-id="{{ section.id }}">
  <div class="container">
    <div class="product-layout">
      <!-- Media Gallery Slider -->
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery__viewport">
          <div class="product-gallery__slider" data-gallery-slider>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                {%- assign is_featured = false -%}
                {%- if media.id == featured_image.id or forloop.first and featured_image == blank -%}
                  {%- assign is_featured = true -%}
                {%- endif -%}
                <div
                  class="product-gallery__slide {% if is_featured %}is-active{% endif %}"
                  data-gallery-slide
                  data-media-id="{{ media.id }}"
                  data-slide-index="{{ forloop.index0 }}"
                >
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1200 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        class="product-gallery__main-img"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="1200"
                        height="1600"
                        data-zoom-src="{{ media | image_url: width: 2400 }}"
                        data-zoom-alt="{{ media.alt | default: product.title | escape }}"
                      >
                      <button
                        type="button"
                        class="product-gallery__zoom-trigger"
                        data-gallery-zoom
                        data-zoom-index="{{ forloop.index0 }}"
                        aria-label="{{ 'products.product.preview_image' | t }}"
                        title="{{ 'products.product.preview_image' | t }}"
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                      </button>
                    {%- when 'video' -%}
                      {{ media | video_tag: controls: true, class: 'product-gallery__video', image_size: '1200x' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag: class: 'product-gallery__video' }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag: class: 'product-gallery__model' }}
                    {%- else -%}
                      <img
                        src="{{ media.preview_image | image_url: width: 1200 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        class="product-gallery__main-img"
                        loading="lazy"
                        width="1200"
                        height="1600"
                        data-zoom-src="{{ media.preview_image | image_url: width: 2400 }}"
                        data-zoom-alt="{{ media.alt | default: product.title | escape }}"
                      >
                      <button
                        type="button"
                        class="product-gallery__zoom-trigger"
                        data-gallery-zoom
                        data-zoom-index="{{ forloop.index0 }}"
                        aria-label="{{ 'products.product.preview_image' | t }}"
                        title="{{ 'products.product.preview_image' | t }}"
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                      </button>
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="product-gallery__slide is-active" data-gallery-slide data-slide-index="0">
                {{ 'product-1' | placeholder_svg_tag: 'product-gallery__main-img' }}
              </div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <!-- Slider Navigation Arrows -->
            <button
              type="button"
              class="product-gallery__arrow product-gallery__arrow--prev"
              data-gallery-prev
              aria-label="{{ 'accessibility.previous_slide' | default: 'Previous image' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              class="product-gallery__arrow product-gallery__arrow--next"
              data-gallery-next
              aria-label="{{ 'accessibility.next_slide' | default: 'Next image' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbnails" data-gallery-thumbnails>
            {%- for media in product.media -%}
              {%- assign is_thumb_active = false -%}
              {%- if media.id == featured_image.id or forloop.first and featured_image == blank -%}
                {%- assign is_thumb_active = true -%}
              {%- endif -%}
              <button
                type="button"
                class="product-gallery__thumb {% if is_thumb_active %}is-active{% endif %}"
                data-gallery-thumb
                data-media-id="{{ media.id }}"
                data-thumb-index="{{ forloop.index0 }}"
                aria-label="{{ 'products.product.media.load_image' | default: 'View image' | t }} {{ forloop.index }}"
              >
                <img src="{{ media.preview_image | image_url: width: 160 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" width="80" height="106">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Buy Box & Details -->
      <div class="product-info">
        {%- if product.vendor != blank -%}
          <span data-product-vendor style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-foreground-secondary);">
            {{ product.vendor }}
          </span>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <!-- Rating Stars (App Compatible) -->
        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem;">
          <div style="display: inline-flex; gap: 2px;">
            {% render 'icon-star' %}
            {% render 'icon-star' %}
            {% render 'icon-star' %}
            {% render 'icon-star' %}
            {% render 'icon-star' %}
          </div>
          <span style="color: var(--color-foreground-secondary); font-weight: 500;">{{ 'products.product.verified_reviews' | t }}</span>
        </div>

        <!-- Price Display -->
        <div style="display: flex; align-items: baseline; gap: 12px; margin-top: 4px;">
          <span class="product-price" style="font-size: 1.5rem;" data-product-price data-currency-format="{{ shop.money_format | escape }}">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="product-price product-price--compare" style="font-size: 1.15rem;" data-product-compare-price>
              {{ current_variant.compare_at_price | money }}
            </s>
            <span class="badge badge-sale" data-discount-badge>-{{ discount_percent }}% OFF</span>
          {%- else -%}
            <s class="product-price product-price--compare" style="font-size: 1.15rem; display: none;" data-product-compare-price></s>
            <span class="badge badge-sale" style="display: none;" data-discount-badge></span>
          {%- endif -%}
        </div>

        <!-- Add to Cart Form -->
        {%- form 'product', product, id: 'MainProductForm', data-ajax-cart-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <!-- Variant Options (Color, Size) -->
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              {%- assign downcased_opt = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if downcased_opt contains 'color' or downcased_opt contains 'colour' or downcased_opt contains 'لون' or downcased_opt contains 'اللون' -%}
                {%- assign is_color = true -%}
              {%- endif -%}
              {%- assign current_selected_val = current_variant.options[option_index] | default: option.selected_value -%}

              <div class="variant-option-group {% if is_color %}variant-option-group--color{% endif %}">
                <div class="variant-option-label">
                  <span>
                    {{ option.name }}: <strong data-option-selected-label>{{ current_selected_val }}</strong>
                  </span>
                  {%- if downcased_opt contains 'size' or downcased_opt contains 'مقاس' -%}
                    <button type="button" data-size-guide-open style="font-size: 0.82rem; font-weight: 600; text-decoration: underline; color: var(--color-foreground);">
                      📏 {{ 'products.product.size_guide' | t }}
                    </button>
                  {%- endif -%}
                </div>

                <div class="variant-pill-list {% if is_color %}variant-pill-list--color{% endif %}">
                  {%- for value in option.values -%}
                    {%- assign value_available = false -%}
                    {%- for variant in product.variants -%}
                      {%- if variant.options[option_index] == value and variant.available -%}
                        {%- assign value_available = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if is_color -%}
                      {%- assign color_variant_media_id = '' -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options[option_index] == value and variant.featured_media != blank -%}
                          {%- assign color_variant_media_id = variant.featured_media.id -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- capture swatch_color -%}{% render 'color-swatch-value', value: value %}{%- endcapture -%}
                      {%- assign swatch_color = swatch_color | strip -%}

                      <button
                        type="button"
                        class="variant-pill variant-pill--color {% if current_selected_val == value %}is-selected{% endif %} {% unless value_available %}is-unavailable{% endunless %}"
                        data-variant-option
                        data-option-index="{{ option_index }}"
                        data-option-value="{{ value | escape }}"
                        {% if color_variant_media_id != blank %}data-media-id="{{ color_variant_media_id }}"{% endif %}
                        aria-label="{{ value | escape }}"
                        title="{{ value | escape }}"
                      >
                        <span
                          class="color-swatch-dot"
                          style="background-color: {{ swatch_color }};"
                        ></span>
                        <span class="color-swatch-label">{{ value }}</span>
                      </button>
                    {%- else -%}
                      <button
                        type="button"
                        class="variant-pill {% if current_selected_val == value %}is-selected{% endif %} {% unless value_available %}is-unavailable{% endunless %}"
                        data-variant-option
                        data-option-index="{{ option_index }}"
                        data-option-value="{{ value | escape }}"
                      >
                        {{ value }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <!-- Quantity & Purchase Action Buttons -->
          <div style="display: flex; gap: 12px; margin-top: 20px; align-items: stretch;">
            <div class="quantity-stepper" style="border-radius: var(--radius-sm); padding: 0 4px;">
              <button type="button" class="quantity-stepper__btn" onclick="const i = this.parentElement.querySelector('input'); i.value = Math.max(1, parseInt(i.value) - 1);">-</button>
              <input type="number" name="quantity" value="1" min="1" class="quantity-stepper__input" style="width: 44px;">
              <button type="button" class="quantity-stepper__btn" onclick="const i = this.parentElement.querySelector('input'); i.value = parseInt(i.value) + 1;">+</button>
            </div>

            <button
              type="submit"
              name="add"
              class="btn btn-primary btn-full"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
              style="padding: 16px; font-size: 1.05rem;"
            >
              {% render 'icon-cart' %}
              <span data-add-to-cart-text>
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>

            <!-- Wishlist Button -->
            <button
              type="button"
              class="btn btn-outline product-main__wishlist"
              data-wishlist-btn
              data-product-handle="{{ product.handle }}"
              data-product-id="{{ product.id }}"
              data-product-title="{{ product.title | escape }}"
              data-product-url="{{ product.url }}"
              data-product-image="{{ featured_image | image_url: width: 600 }}"
              data-product-price="{{ current_variant.price | money }}"
              data-product-compare-price="{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}"
              data-product-vendor="{{ product.vendor | escape }}"
              style="padding: 0 16px; min-width: 52px; display: inline-flex; align-items: center; justify-content: center;"
              aria-label="{{ 'products.product.add_to_wishlist' | t }}"
            >
              {% render 'icon-heart' %}
            </button>
          </div>

          <!-- Dynamic Checkout Button -->
          <div style="margin-top: 10px;">
            {{ form | payment_button }}
          </div>
        {%- endform -%}

        <!-- Information Tabs / Accordions -->
        <div class="product-accordion">
          <!-- Description -->
          {%- if product.description != blank -%}
            <div class="accordion-item">
              <button type="button" class="accordion-header is-active" aria-expanded="true">
                <span>{{ 'products.product.description' | t }}</span>
                {% render 'icon-chevron' %}
              </button>
              <div class="accordion-content is-open" style="max-height: 500px;">
                <div class="rte">
                  {{ product.description }}
                </div>
              </div>
            </div>
          {%- endif -%}

          <!-- Product Details (Metafield) -->
          {%- assign product_details_meta = product.metafields.custom.product_details -%}
          {%- if product_details_meta != blank and product_details_meta.value != blank -%}
            <div class="accordion-item" data-metafield-section="product-details">
              <button type="button" class="accordion-header" aria-expanded="false">
                <span>{{ 'products.product.details' | t }}</span>
                {% render 'icon-chevron' %}
              </button>
              <div class="accordion-content">
                <div class="product-details__content rte">
                  {%- if product_details_meta.type == 'rich_text_field' -%}
                    {{ product_details_meta | metafield_tag }}
                  {%- elsif product_details_meta.type == 'multi_line_text_field' -%}
                    <p>{{ product_details_meta.value | newline_to_br }}</p>
                  {%- elsif product_details_meta.value != blank -%}
                    {{ product_details_meta | metafield_tag }}
                  {%- else -%}
                    {{ product_details_meta }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          <!-- Key Features (Metafield) -->
          {%- assign key_features_meta = product.metafields.custom.key_features -%}
          {%- if key_features_meta != blank and key_features_meta.value != blank -%}
            <div class="accordion-item" data-metafield-section="key-features">
              <button type="button" class="accordion-header" aria-expanded="false">
                <span>{{ 'products.product.key_features' | t }}</span>
                {% render 'icon-chevron' %}
              </button>
              <div class="accordion-content">
                <div class="product-features__content rte">
                  {%- if key_features_meta.type == 'rich_text_field' -%}
                    {{ key_features_meta | metafield_tag }}
                  {%- elsif key_features_meta.type == 'multi_line_text_field' -%}
                    <p>{{ key_features_meta.value | newline_to_br }}</p>
                  {%- elsif key_features_meta.value.first -%}
                    <ul class="product-features-list">
                      {%- for feature in key_features_meta.value -%}
                        {%- assign feature_text = feature | strip -%}
                        {%- if feature_text != blank -%}
                          <li>{{ feature_text }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- elsif key_features_meta.value != blank -%}
                    {{ key_features_meta | metafield_tag }}
                  {%- else -%}
                    {{ key_features_meta }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          <!-- Shipping & Delivery -->
          <div class="accordion-item">
            <button type="button" class="accordion-header" aria-expanded="false">
              <span>{{ 'products.product.shipping_info' | t }}</span>
              {% render 'icon-chevron' %}
            </button>
            <div class="accordion-content">
              <p><strong>{{ 'products.product.shipping_gov_title' | t }}</strong></p>
              <ul style="padding-left: 20px; margin-top: 8px; line-height: 1.8;">
                <li>{{ 'products.product.shipping_cairo_giza' | t }}</li>
                <li>{{ 'products.product.shipping_alex_delta' | t }}</li>
                <li>{{ 'products.product.shipping_upper_coastal' | t }}</li>
                <li><strong>{{ 'products.product.shipping_free_threshold' | t }}</strong></li>
              </ul>
            </div>
          </div>

          <!-- Returns & 14-Day Exchange -->
          <div class="accordion-item">
            <button type="button" class="accordion-header" aria-expanded="false">
              <span>{{ 'products.product.returns_policy' | t }}</span>
              {% render 'icon-chevron' %}
            </button>
            <div class="accordion-content">
              <p>
                {{ 'products.product.returns_policy_text' | t }}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Image Preview / Lightbox Modal -->
  <div id="ProductMediaModal-{{ section.id }}" class="product-media-modal" role="dialog" aria-modal="true" aria-label="{{ 'products.product.gallery_viewer' | default: 'Product image preview' | t }}" style="display: none;">
    <div class="product-media-modal__backdrop" data-media-modal-close></div>
    <div class="product-media-modal__dialog">
      <div class="product-media-modal__header">
        <button type="button" class="product-media-modal__btn product-media-modal__btn--zoom" data-media-modal-zoom aria-label="{{ 'products.product.preview_image' | default: 'Zoom in' | t }}" title="{{ 'products.product.preview_image' | default: 'Zoom in' | t }}">
          <svg class="icon-zoom-in" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <svg class="icon-zoom-out" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
        <button type="button" class="product-media-modal__btn product-media-modal__btn--close" data-media-modal-close aria-label="{{ 'accessibility.close' | default: 'Close' | t }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      {%- if product.media.size > 1 -%}
        <button type="button" class="product-media-modal__arrow product-media-modal__arrow--prev" data-media-modal-prev aria-label="{{ 'accessibility.previous_slide' | default: 'Previous image' | t }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="product-media-modal__arrow product-media-modal__arrow--next" data-media-modal-next aria-label="{{ 'accessibility.next_slide' | default: 'Next image' | t }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      {%- endif -%}

      <div class="product-media-modal__content" data-media-modal-content>
        <img src="" alt="" class="product-media-modal__img" data-media-modal-img>
      </div>

      {%- if product.media.size > 1 -%}
        <div class="product-media-modal__counter" data-media-modal-counter>
          <span data-media-modal-current>1</span> / <span data-media-modal-total>{{ product.media.size }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Product JSON for Dynamic Variant Updates -->
  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

{% schema %}
{
  "name": "Product Main Information",
  "settings": []
}
{% endschema %}
