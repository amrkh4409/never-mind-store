<div class="container" style="padding-top: 50px; padding-bottom: 80px; max-width: 720px;">
  <div style="margin-bottom: 24px;">
    <a href="{{ routes.account_url }}" class="btn btn-outline btn-sm">&larr; {{ 'customer.orders.back_to_account' | t }}</a>
  </div>

  <h1 style="font-size: 1.8rem; margin-bottom: 24px;">{{ 'customer.addresses.title' | t }}</h1>

  {%- paginate customer.addresses by 5 -%}
    {%- for address in customer.addresses -%}
      <div style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 20px; margin-bottom: 20px;">
        {%- if address == customer.default_address -%}
          <span class="badge badge-cod" style="margin-bottom: 8px;">{{ 'customer.addresses.default' | t }}</span>
        {%- endif -%}
        <p style="font-size: 0.95rem; line-height: 1.6; color: var(--color-foreground);">
          <strong>{{ address.name }}</strong><br>
          {{ address.company }}<br>
          {{ address.street }}<br>
          {{ address.city }}, {{ address.province }} {{ address.zip }}<br>
          {{ address.country }}<br>
          {{ address.phone }}
        </p>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
</div>
