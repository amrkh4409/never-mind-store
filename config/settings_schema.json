[
  {
    "name": "theme_info",
    "theme_name": "Never Mind - Luxury Fashion",
    "theme_version": "1.0.0",
    "theme_author": "Never Mind Store",
    "theme_documentation_url": "https://nevermindstore.com",
    "theme_support_url": "https://nevermindstore.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "General Colors"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "label": "Secondary Background",
        "default": "#F7F7F8"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Text Color",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_foreground_secondary",
        "label": "Secondary Text Color",
        "default": "#6B7280"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Color",
        "default": "#E5E7EB"
      },
      {
        "type": "header",
        "content": "Brand & Accent"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / Discount Badge",
        "default": "#E05A47"
      },
      {
        "type": "header",
        "content": "Buttons"
      },
      {
        "type": "color",
        "id": "color_button_bg",
        "label": "Button Background",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button Text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_button_hover_bg",
        "label": "Button Hover Background",
        "default": "#2D2D2D"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Headings Font",
        "default": "sans-serif"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body Font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Base Font Size",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout & Spacing",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "label": "Container Width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 16,
        "step": 2,
        "unit": "px",
        "label": "Element Corner Radius",
        "default": 6
      }
    ]
  },
  {
    "name": "Product Cards",
    "settings": [
      {
        "type": "select",
        "id": "product_card_aspect_ratio",
        "label": "Image Aspect Ratio",
        "options": [
          { "value": "3/4", "label": "Portrait (3:4) - Recommended for Fashion" },
          { "value": "1/1", "label": "Square (1:1)" },
          { "value": "4/5", "label": "Tall (4:5)" }
        ],
        "default": "3/4"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_swatches",
        "label": "Show color swatches preview",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Enable Quick Add to Cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_view",
        "label": "Enable Quick View Modal",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_wishlist",
        "label": "Show Wishlist button",
        "default": true
      }
    ]
  },
  {
    "name": "Cart Drawer & Shipping",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable slide-out Cart Drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show Free Shipping Progress Bar",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (in store currency EGP)",
        "default": 1000
      },
      {
        "type": "text",
        "id": "free_shipping_message",
        "label": "Free Shipping Unlocked Message",
        "default": "Congratulations! You've unlocked FREE SHIPPING"
      },
      {
        "type": "checkbox",
        "id": "enable_cart_notes",
        "label": "Enable Order Special Instructions / Notes",
        "default": true
      }
    ]
  },
  {
    "name": "Egypt & Cash on Delivery (COD)",
    "settings": [
      {
        "type": "header",
        "content": "Cash on Delivery Reassurance"
      },
      {
        "type": "checkbox",
        "id": "enable_cod_badge",
        "label": "Display Cash on Delivery Badge",
        "default": true
      },
      {
        "type": "text",
        "id": "cod_badge_text",
        "label": "COD Badge Text",
        "default": "Cash on Delivery Available Across Egypt"
      },
      {
        "type": "text",
        "id": "inspection_badge_text",
        "label": "Inspection Guarantee Text",
        "default": "Open & Inspect Package Before Payment"
      },
      {
        "type": "text",
        "id": "delivery_time_text",
        "label": "Estimated Delivery Time",
        "default": "Cairo & Giza: 24-48 hrs | All Governorates: 2-4 Days"
      }
    ]
  },
  {
    "name": "Floating WhatsApp Contact",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_whatsapp",
        "label": "Enable Floating WhatsApp Button",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp Phone Number (with country code, e.g. 201000000000)",
        "default": "201000000000"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Default WhatsApp Message",
        "default": "Hello Never Mind Store, I have an inquiry about my order / size."
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Factory & Dropshipping Settings",
    "settings": [
      {
        "type": "paragraph",
        "content": "The storefront is architected to cleanly separate customer-facing data from direct-factory dropshipping metadata. Factory metadata fields (e.g. custom.supplier_id, custom.factory_id, custom.supplier_cost) are kept private in Shopify admin metafields and will never be displayed to storefront shoppers."
      }
    ]
  }
]
