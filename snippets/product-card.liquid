{%- comment -%}
  Renders a luxury fashion product card inspired by Modex
  Usage:
  {% render 'product-card', product_card_product: product, show_vendor: true %}
{%- endcomment -%}

{%- liquid
  assign product = product_card_product
  assign current_variant = product.selected_or_first_available_variant
  assign has_secondary_image = false
  if product.media.size > 1
    assign has_secondary_image = true
  endif

  assign discount_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

<div class="product-card" data-product-card data-product-id="{{ product.id }}">
  <div class="product-card__media-wrapper">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}" style="display: block; width: 100%; height: 100%;">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 600 }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy"
          width="600"
          height="800"
          class="product-card__img product-card__img--primary"
        >
        {%- if has_secondary_image -%}
          <img
            src="{{ product.media[1] | image_url: width: 600 }}"
            alt="{{ product.media[1].alt | default: product.title | escape }}"
            loading="lazy"
            width="600"
            height="800"
            class="product-card__img product-card__img--secondary"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img' }}
      {%- endif -%}
    </a>

    <!-- Product Badges -->
    <div class="product-card__badges">
      {%- if current_variant.available == false -%}
        <span class="badge badge-soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif discount_percent > 0 -%}
        <span class="badge badge-sale">-{{ discount_percent }}%</span>
      {%- endif -%}
    </div>

    <!-- Wishlist Button -->
    <button
      type="button"
      class="product-card__wishlist"
      data-wishlist-btn
      data-product-handle="{{ product.handle }}"
      aria-label="{{ 'sections.header.wishlist' | t }}"
    >
      {% render 'icon-heart' %}
    </button>

    <!-- Quick Action Hover Bar -->
    <div class="product-card__quick-actions">
      {%- if current_variant.available -%}
        {%- if product.has_only_default_variant -%}
          <form method="post" action="/cart/add" data-ajax-cart-form style="flex: 1;">
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="product-card__quick-btn" style="width: 100%;">
              {% render 'icon-cart' %}
              <span>{{ 'products.product.quick_add' | t }}</span>
            </button>
          </form>
        {%- else -%}
          <a href="{{ product.url }}" class="product-card__quick-btn">
            <span>{{ 'products.product.choose_options' | t }}</span>
          </a>
        {%- endif -%}
      {%- else -%}
        <button type="button" class="product-card__quick-btn" disabled style="opacity: 0.6; cursor: not-allowed;">
          <span>{{ 'products.product.sold_out' | t }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>

  <!-- Product Info -->
  <div class="product-card__content">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {% render 'price', product: product %}

    <!-- Color Swatches Preview if option named Color exists -->
    {%- for option in product.options_with_values -%}
      {%- assign downcased_option = option.name | downcase -%}
      {%- if downcased_option contains 'color' or downcased_option contains 'colour' or downcased_option contains 'لون' -%}
        {%- assign option_index = forloop.index0 -%}
        <div class="product-card__swatches">
          {%- for value in option.values limit: 6 -%}
            {%- assign variant_image = '' -%}
            {%- assign swatch_thumb = '' -%}
            {%- for variant in product.variants -%}
              {%- if variant.options[option_index] == value -%}
                {%- if variant.featured_media != blank -%}
                  {%- assign variant_image = variant.featured_media | image_url: width: 600 -%}
                  {%- assign swatch_thumb = variant.featured_media | image_url: width: 80, height: 80, crop: 'center' -%}
                  {%- break -%}
                {%- elsif variant.image != blank -%}
                  {%- assign variant_image = variant.image | image_url: width: 600 -%}
                  {%- assign swatch_thumb = variant.image | image_url: width: 80, height: 80, crop: 'center' -%}
                  {%- break -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- capture bg_color -%}{% render 'color-swatch-value', value: value, image: swatch_thumb %}{%- endcapture -%}
            {%- assign bg_color = bg_color | strip -%}

            <button
              type="button"
              class="product-card__swatch-dot {% if forloop.first %}is-active{% endif %}"
              style="background: {{ bg_color }};"
              data-card-swatch
              {% if variant_image != blank %}data-variant-image="{{ variant_image }}"{% endif %}
              aria-label="{{ value | escape }}"
              title="{{ value | escape }}"
            ></button>
          {%- endfor -%}
          {%- if option.values.size > 6 -%}
            <span style="font-size: 0.72rem; color: var(--color-foreground-muted); margin-left: 2px;">+{{ option.values.size | minus: 6 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
