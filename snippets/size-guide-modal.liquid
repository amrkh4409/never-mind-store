{%- comment -%}
  Reusable Size Guide Modal for Fashion Products
  Editable via theme settings or product metafields
{%- endcomment -%}

<div id="SizeGuideModal" class="modal-wrapper" role="dialog" aria-modal="true" aria-label="{{ 'sections.size_guide.title' | t }}">
  <div class="modal-content">
    <button type="button" class="modal-close-btn" data-size-guide-close aria-label="{{ 'sections.size_guide.close' | t }}">
      {% render 'icon-close' %}
    </button>

    <h3 style="margin-bottom: 8px;">{{ 'sections.size_guide.title' | t }}</h3>
    <p style="color: var(--color-foreground-secondary); font-size: 0.9rem; margin-bottom: 24px;">
      All measurements are in centimeters (cm) unless specified. Fits may vary slightly depending on fabric stretch.
    </p>

    <!-- Tops Sizing Table -->
    <h4 style="font-size: 1.05rem; margin-bottom: 10px;">Tops, Shirts & Hoodies</h4>
    <div style="overflow-x: auto;">
      <table class="size-guide-table">
        <thead>
          <tr>
            <th>Size</th>
            <th>Chest (cm)</th>
            <th>Length (cm)</th>
            <th>Shoulder (cm)</th>
            <th>Recommended Weight</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>S</strong></td>
            <td>102 - 106</td>
            <td>70</td>
            <td>46</td>
            <td>60 - 70 kg</td>
          </tr>
          <tr>
            <td><strong>M</strong></td>
            <td>106 - 110</td>
            <td>72</td>
            <td>48</td>
            <td>70 - 80 kg</td>
          </tr>
          <tr>
            <td><strong>L</strong></td>
            <td>110 - 116</td>
            <td>74</td>
            <td>50</td>
            <td>80 - 90 kg</td>
          </tr>
          <tr>
            <td><strong>XL</strong></td>
            <td>116 - 122</td>
            <td>76</td>
            <td>52</td>
            <td>90 - 100 kg</td>
          </tr>
          <tr>
            <td><strong>XXL</strong></td>
            <td>122 - 128</td>
            <td>78</td>
            <td>54</td>
            <td>100 - 115 kg</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pants & Shorts Sizing Table -->
    <h4 style="font-size: 1.05rem; margin-top: 24px; margin-bottom: 10px;">Pants, Gabardine & Shorts</h4>
    <div style="overflow-x: auto;">
      <table class="size-guide-table">
        <thead>
          <tr>
            <th>Waist Size</th>
            <th>Waist (cm)</th>
            <th>Length (cm)</th>
            <th>Thigh (cm)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>30</td><td>78 - 81</td><td>100</td><td>56</td></tr>
          <tr><td>32</td><td>82 - 85</td><td>102</td><td>58</td></tr>
          <tr><td>34</td><td>86 - 89</td><td>103</td><td>60</td></tr>
          <tr><td>36</td><td>90 - 94</td><td>104</td><td>63</td></tr>
          <tr><td>38</td><td>95 - 100</td><td>105</td><td>66</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Tips on Measuring -->
    <div style="margin-top: 24px; padding: 16px; background-color: var(--color-bg-secondary); border-radius: var(--radius-sm);">
      <h5 style="margin-bottom: 6px;">{{ 'sections.size_guide.tips_title' | t }}</h5>
      <p style="font-size: 0.85rem; color: var(--color-foreground-secondary); line-height: 1.5;">
        {{ 'sections.size_guide.tips_body' | t }}
        <br>
        <em>Note: Our courier allows you to inspect and try on your item upon delivery across Egypt!</em>
      </p>
    </div>
  </div>
</div>
