{%- comment -%}
  Dynamically resolves color from Shopify product option value or native swatch data.
  Supports:
  - Native Shopify swatches (image or color)
  - Dual/double colors (e.g. "Black/White", "أسود/أبيض", "Navy & Beige") with 135deg split gradient
  - Single colors in English and Arabic
  - Automatic fallback to the variant product image if the color is unadded/unknown
  Usage:
  {% render 'color-swatch-value', value: value, image: variant_image_url %}
{%- endcomment -%}
{%- liquid
  if value.swatch.image != blank
    assign swatch_img_url = value.swatch.image | image_url: width: 160, height: 160, crop: 'center'
    if swatch_img_url contains '//' and swatch_img_url contains 'http' == false
      assign swatch_img_url = 'https:' | append: swatch_img_url
    endif
    echo "url('" | append: swatch_img_url | append: "') center / cover no-repeat"
  elsif value.swatch.color != blank
    echo value.swatch.color
  else
    assign raw_val = value | strip
    assign delimiter = ''
    if raw_val contains ' / '
      assign delimiter = ' / '
    elsif raw_val contains '/'
      assign delimiter = '/'
    elsif raw_val contains ' \ '
      assign delimiter = ' \ '
    elsif raw_val contains '\'
      assign delimiter = '\'
    elsif raw_val contains ' & '
      assign delimiter = ' & '
    elsif raw_val contains '&'
      assign delimiter = '&'
    elsif raw_val contains ' + '
      assign delimiter = ' + '
    elsif raw_val contains '+'
      assign delimiter = '+'
    elsif raw_val contains ' and '
      assign delimiter = ' and '
    elsif raw_val contains ' AND '
      assign delimiter = ' AND '
    elsif raw_val contains ' - '
      assign delimiter = ' - '
    elsif raw_val contains '-'
      assign delimiter = '-'
    elsif raw_val contains ' _ '
      assign delimiter = ' _ '
    elsif raw_val contains '_'
      assign delimiter = '_'
    elsif raw_val contains ' x '
      assign delimiter = ' x '
    elsif raw_val contains ' X '
      assign delimiter = ' X '
    elsif raw_val contains ','
      assign delimiter = ','
    elsif raw_val contains ' مع '
      assign delimiter = ' مع '
    elsif raw_val contains ' و '
      assign delimiter = ' و '
    elsif raw_val contains ' و'
      assign delimiter = ' و'
    endif

    if delimiter != ''
      assign parts = raw_val | split: delimiter
    else
      assign parts = raw_val | split: '|||'
    endif

    assign hex1 = ''
    assign hex2 = ''
    assign idx = 0

    for part in parts limit: 2
      assign color_clean = part | downcase | strip | replace: '-', ' ' | replace: '_', ' '
      assign res_hex = ''

      case color_clean
        when 'white', 'snow', 'pure white', 'off white', 'offwhite', 'أبيض', 'ابيض', 'الابيض', 'الأبيض', 'اوف وايت'
          assign res_hex = '#FFFFFF'
        when 'black', 'noir', 'nero', 'midnight black', 'أسود', 'اسود', 'الأسود', 'الاسود'
          assign res_hex = '#111111'
        when 'gold', 'golden', 'metallic gold', 'ذهب', 'ذهبي', 'الذهب', 'الذهبي', 'دهب', 'دهبي', 'الدهب', 'الدهبي', 'جولد', 'الجولد'
          assign res_hex = '#D4AF37'
        when 'rose gold', 'روز جولد', 'ذهب وردي', 'دهب وردي'
          assign res_hex = '#B76E79'
        when 'silver', 'metallic silver', 'فضة', 'فضي', 'الفضة', 'الفضي', 'سيلفر', 'السيلفر'
          assign res_hex = '#C0C0C0'
        when 'charcoal', 'dark grey', 'dark gray', 'فحم', 'شحم', 'فحمي', 'الفحمي'
          assign res_hex = '#2C2D30'
        when 'grey', 'gray', 'heather grey', 'heather gray', 'light grey', 'light gray', 'رمادي', 'رصاصي', 'فيراني', 'الرمادي', 'الرصاصي', 'الفيراني'
          assign res_hex = '#9E9E9E'
        when 'beige', 'sand', 'cream', 'creme', 'ivory', 'nude', 'بيج', 'كريمي', 'عاجي', 'سكري', 'البيج', 'الكريمي', 'العاجي', 'السكري'
          assign res_hex = '#E6D7C3'
        when 'camel', 'tan', 'جملي', 'الجملي', 'تان'
          assign res_hex = '#C19A6B'
        when 'brown', 'chocolate', 'dark brown', 'mocha', 'coffee', 'بني', 'هافان', 'شوكولاتة', 'كافيه', 'البني', 'الهافان', 'الكافيه'
          assign res_hex = '#5C3A21'
        when 'navy', 'navy blue', 'dark blue', 'كحلي', 'أزرق داكن', 'ازرق داكن', 'الكحلي', 'الأزرق الداكن', 'الازرق الداكن'
          assign res_hex = '#0F1E36'
        when 'blue', 'royal blue', 'sky blue', 'baby blue', 'أزرق', 'ازرق', 'نيلي', 'سماوي', 'بيبي بلو', 'الأزرق', 'الازرق', 'السماوي', 'النيلي'
          assign res_hex = '#2563EB'
        when 'olive', 'olive green', 'army green', 'army', 'khaki', 'زيتي', 'زتوني', 'كاكي', 'الزيتي', 'الكاكي'
          assign res_hex = '#4D5638'
        when 'green', 'forest green', 'emerald', 'dark green', 'أخضر', 'اخضر', 'فستقي', 'الأخضر', 'الاخضر', 'الفستقي'
          assign res_hex = '#15803D'
        when 'mint', 'mint green', 'نعناعي', 'مينت', 'المينت'
          assign res_hex = '#A7F3D0'
        when 'burgundy', 'maroon', 'wine', 'bordeaux', 'نبيتي', 'عنابي', 'مارون', 'بورجوندي', 'النبيتي', 'العنابي', 'البورجوندي'
          assign res_hex = '#5B1422'
        when 'red', 'crimson', 'ruby', 'أحمر', 'احمر', 'الأحمر', 'الاحمر'
          assign res_hex = '#DC2626'
        when 'orange', 'rust', 'terracotta', 'peach', 'برتقالي', 'أورانج', 'اورانج', 'خوخي', 'البرتقالي', 'الاورانج', 'الأورانج'
          assign res_hex = '#EA580C'
        when 'yellow', 'mustard', 'أصفر', 'اصفر', 'مسطردة', 'الأصفر', 'الاصفر', 'المسطردة'
          assign res_hex = '#EAB308'
        when 'pink', 'rose', 'blush', 'dusty pink', 'وردي', 'روز', 'بمبي', 'كشمير', 'زهري', 'الوردي', 'الروز', 'الكشمير', 'الزهري'
          assign res_hex = '#F472B6'
        when 'purple', 'violet', 'lavender', 'lilac', 'بنفسجي', 'موف', 'لافندر', 'ارجواني', 'البنفسجي', 'الموف', 'اللافندر'
          assign res_hex = '#7E22CE'
        when 'teal', 'turquoise', 'cyan', 'تركواز', 'تيل', 'فيروزي', 'التركواز', 'الفيروزي'
          assign res_hex = '#0D9488'
        else
          if color_clean contains 'rose gold' or color_clean contains 'روز جولد' or color_clean contains 'ذهب وردي' or color_clean contains 'دهب وردي'
            assign res_hex = '#B76E79'
          elsif color_clean contains 'gold' or color_clean contains 'ذهب' or color_clean contains 'دهب' or color_clean contains 'جولد'
            assign res_hex = '#D4AF37'
          elsif color_clean contains 'silver' or color_clean contains 'فض' or color_clean contains 'سيلفر'
            assign res_hex = '#C0C0C0'
          elsif color_clean contains 'black' or color_clean contains 'أسود' or color_clean contains 'اسود'
            assign res_hex = '#111111'
          elsif color_clean contains 'white' or color_clean contains 'أبيض' or color_clean contains 'ابيض'
            assign res_hex = '#FFFFFF'
          elsif color_clean contains 'beige' or color_clean contains 'بيج' or color_clean contains 'cream' or color_clean contains 'sand'
            assign res_hex = '#E6D7C3'
          elsif color_clean contains 'camel' or color_clean contains 'جملي'
            assign res_hex = '#C19A6B'
          elsif color_clean contains 'gray' or color_clean contains 'grey' or color_clean contains 'رمادي' or color_clean contains 'رصاصي'
            assign res_hex = '#9E9E9E'
          elsif color_clean contains 'navy' or color_clean contains 'كحلي'
            assign res_hex = '#0F1E36'
          elsif color_clean contains 'blue' or color_clean contains 'أزرق' or color_clean contains 'ازرق'
            assign res_hex = '#2563EB'
          elsif color_clean contains 'olive' or color_clean contains 'زيتي' or color_clean contains 'khaki' or color_clean contains 'كاكي'
            assign res_hex = '#4D5638'
          elsif color_clean contains 'green' or color_clean contains 'أخضر' or color_clean contains 'اخضر'
            assign res_hex = '#15803D'
          elsif color_clean contains 'brown' or color_clean contains 'بني' or color_clean contains 'هافان'
            assign res_hex = '#5C3A21'
          elsif color_clean contains 'burgundy' or color_clean contains 'نبيتي' or color_clean contains 'maroon' or color_clean contains 'عنابي'
            assign res_hex = '#5B1422'
          elsif color_clean contains 'red' or color_clean contains 'أحمر' or color_clean contains 'احمر'
            assign res_hex = '#DC2626'
          elsif color_clean contains 'pink' or color_clean contains 'وردي' or color_clean contains 'كشمير' or color_clean contains 'روز'
            assign res_hex = '#F472B6'
          elsif color_clean contains 'purple' or color_clean contains 'بنفسجي' or color_clean contains 'موف'
            assign res_hex = '#7E22CE'
          elsif color_clean contains 'yellow' or color_clean contains 'أصفر' or color_clean contains 'اصفر' or color_clean contains 'مسطردة'
            assign res_hex = '#EAB308'
          elsif color_clean contains 'orange' or color_clean contains 'برتقالي' or color_clean contains 'اورانج'
            assign res_hex = '#EA580C'
          elsif color_clean contains 'teal' or color_clean contains 'تركواز' or color_clean contains 'فيروزي'
            assign res_hex = '#0D9488'
          endif
      endcase

      if idx == 0
        assign hex1 = res_hex
      else
        assign hex2 = res_hex
      endif
      assign idx = idx | plus: 1
    endfor

    assign resolved_img = image
    if resolved_img != blank and resolved_img contains '//' and resolved_img contains 'http' == false
      assign resolved_img = 'https:' | append: resolved_img
    endif

    if delimiter != '' and parts.size >= 2
      if hex1 != blank and hex2 != blank
        echo 'linear-gradient(135deg, ' | append: hex1 | append: ' 50%, ' | append: hex2 | append: ' 50%)'
      elsif resolved_img != blank
        echo "url('" | append: resolved_img | append: "') center / cover no-repeat"
      elsif hex1 != blank
        echo hex1
      elsif hex2 != blank
        echo hex2
      else
        echo '#E2E8F0'
      endif
    else
      if hex1 != blank
        echo hex1
      elsif resolved_img != blank
        echo "url('" | append: resolved_img | append: "') center / cover no-repeat"
      else
        echo '#E2E8F0'
      endif
    endif
  endif
-%}
