<!-- Promo Banner Card -->
<div class="mega-menu__promo-col">
  <a href="/collections/women" class="mega-menu__promo">
    <div class="mega-menu__promo-img-wrap">
      <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=500&q=80" alt="Women Collection" class="mega-menu__promo-img" loading="lazy">
      <div class="mega-menu__promo-overlay"></div>
    </div>
    <div class="mega-menu__promo-content">
      <span class="mega-menu__promo-tag">
        {% if request.locale.iso_code == 'ar' %}الأكثر طلباً{% else %}TRENDING{% endif %}
      </span>
      <h4 class="mega-menu__promo-title">
        {% if request.locale.iso_code == 'ar' %}أحدث كولكشن حريمي 2026{% else %}Women's Collection 2026{% endif %}
      </h4>
      <span class="mega-menu__promo-btn">
        {% if request.locale.iso_code == 'ar' %}تسوق الآن{% else %}Shop Now{% endif %}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>
  </a>
</div>
