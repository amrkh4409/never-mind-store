<!-- Women's Mega Menu Columns (Customizable via Shopify Theme Editor) -->
{%- if section.settings.women_menu != blank and linklists[section.settings.women_menu].links.size > 0 -%}
  {%- for child_link in linklists[section.settings.women_menu].links -%}
    <div class="mega-menu__col">
      <a href="{{ child_link.url }}" class="mega-menu__heading">{{ child_link.title }}</a>
      {%- if child_link.links.size > 0 -%}
        <ul class="mega-menu__list">
          {%- for grandchild in child_link.links -%}
            <li class="mega-menu__item"><a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- else -%}
  <!-- Default Curated Women's Streetwear Categories -->
  <div class="mega-menu__col">
    <a href="/collections/women" class="mega-menu__heading">
      {% if request.locale.iso_code == 'ar' %}توبات وتيشيرتات{% else %}Tops & T-Shirts{% endif %}
    </a>
    <ul class="mega-menu__list">
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}كروب توب قطن عصري{% else %}Cropped Heavyweight Tees{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}تيشيرتات أوفر سايز بناتي{% else %}Oversized Graphic Tees{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}توبات صيفية بيسك كاجوال{% else %}Basic Ribbed Tank Tops{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}بلوزات خفيفة وأنيقة{% else %}Casual Blouses & Shirts{% endif %}</a></li>
    </ul>
  </div>

  <div class="mega-menu__col">
    <a href="/collections/women" class="mega-menu__heading">
      {% if request.locale.iso_code == 'ar' %}هوديز وسويت شيرت{% else %}Hoodies & Sweats{% endif %}
    </a>
    <ul class="mega-menu__list">
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}هوديز لاونج مريح فاخر{% else %}Minimalist Lounge Hoodies{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}كروب هوديز عصري{% else %}Cropped Sweaters{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}كارديجان وجاكيت خفيف{% else %}Cardigans & Light Jackets{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}سويت شيرت قطن فاخر{% else %}Crewneck Sweatshirts{% endif %}</a></li>
    </ul>
  </div>

  <div class="mega-menu__col">
    <a href="/collections/women" class="mega-menu__heading">
      {% if request.locale.iso_code == 'ar' %}بنطلونات وليجن{% else %}Pants & Leggings{% endif %}
    </a>
    <ul class="mega-menu__list">
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}بنطلونات فلير واسعة (Wide Leg){% else %}Wide-Leg Comfort Pants{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}بنطلونات كارجو خصر عالي{% else %}High-Waist Cargo Pants{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}سويت بانتس مريح للمنزل والشارع{% else %}Relaxed Fit Sweatpants{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}جينز مودرن عصري{% else %}Modern Straight Jeans{% endif %}</a></li>
    </ul>
  </div>

  <div class="mega-menu__col">
    <a href="/collections/women" class="mega-menu__heading">
      {% if request.locale.iso_code == 'ar' %}أطقم وبيجامات{% else %}Sets & Loungewear{% endif %}
    </a>
    <ul class="mega-menu__list">
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}أطقم قطعتين متناسقة (Co-ord){% else %}Matching 2-Piece Sets{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}بيجامات وملابس منزلية مريحة{% else %}Comfort Loungewear{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/best-sellers" class="mega-menu__link" style="color: var(--color-primary); font-weight: 600;">{% if request.locale.iso_code == 'ar' %}الأكثر طلباً حريمي &larr;{% else %}Women's Trending &rarr;{% endif %}</a></li>
      <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link" style="font-weight: 700; text-decoration: underline;">{% if request.locale.iso_code == 'ar' %}عرض كل منتجات النساء{% else %}Shop All Women's Collection{% endif %}</a></li>
    </ul>
  </div>
{%- endif -%}

<!-- Customizable Women Promo Banner Card -->
{%- assign women_img = section.settings.women_promo_image -%}
{%- assign women_url = section.settings.women_promo_url | default: '/collections/women' -%}
{%- assign women_title = section.settings.women_promo_title -%}
{%- assign women_badge = section.settings.women_promo_badge -%}
{%- assign women_btn = section.settings.women_promo_btn -%}

<div class="mega-menu__promo-col">
  <a href="{{ women_url }}" class="mega-menu__promo">
    <div class="mega-menu__promo-img-wrap">
      {%- if women_img != blank -%}
        <img src="{{ women_img | image_url: width: 600 }}" alt="{{ women_title | default: 'Women Collection' }}" class="mega-menu__promo-img" loading="lazy">
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=500&q=80" alt="Women Collection" class="mega-menu__promo-img" loading="lazy">
      {%- endif -%}
      <div class="mega-menu__promo-overlay"></div>
    </div>
    <div class="mega-menu__promo-content">
      <span class="mega-menu__promo-tag">
        {%- if women_badge != blank -%}
          {{ women_badge }}
        {%- elsif request.locale.iso_code == 'ar' -%}
          الأكثر طلباً
        {%- else -%}
          TRENDING
        {%- endif -%}
      </span>
      <h4 class="mega-menu__promo-title">
        {%- if women_title != blank -%}
          {{ women_title }}
        {%- elsif request.locale.iso_code == 'ar' -%}
          أحدث كولكشن حريمي 2026
        {%- else -%}
          Women's Collection 2026
        {%- endif -%}
      </h4>
      <span class="mega-menu__promo-btn">
        {%- if women_btn != blank -%}
          {{ women_btn }}
        {%- elsif request.locale.iso_code == 'ar' -%}
          تسوق الآن
        {%- else -%}
          Shop Now
        {%- endif -%}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>
  </a>
</div>
