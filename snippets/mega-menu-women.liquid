<div class="mega-menu__col">
  <a href="/collections/women" class="mega-menu__heading">
    {% if request.locale.iso_code == 'ar' %}أطقم وبيجامات{% else %}Sets & Loungewear{% endif %}
  </a>
  <ul class="mega-menu__list">
    <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}أطقم قطعتين متناسقة (Co-ord){% else %}Matching 2-Piece Sets{% endif %}</a></li>
    <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}بيجامات وملابس منزلية مريحة{% else %}Comfort Loungewear{% endif %}</a></li>
