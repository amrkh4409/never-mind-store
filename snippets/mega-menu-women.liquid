<!-- Women's Mega Menu Columns -->
<div class="mega-menu__col">
  <a href="/collections/women" class="mega-menu__heading">
    {% if request.locale.iso_code == 'ar' %}توبات وتيشيرتات{% else %}Tops & T-Shirts{% endif %}
  </a>
  <ul class="mega-menu__list">
    <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}كروب توب قطن عصري{% else %}Cropped Heavyweight Tees{% endif %}</a></li>
    <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}تيشيرتات أوفر سايز بناتي{% else %}Oversized Graphic Tees{% endif %}</a></li>
    <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}توبات صيفية بيسك كاجوال{% else %}Basic Ribbed Tank Tops{% endif %}</a></li>
    <li class="mega-menu__item"><a href="/collections/women" class="mega-menu__link">{% if request.locale.iso_code == 'ar' %}بلوزات خفيفة وأنيقة{% else %}Casual Blouses & Shirts{% endif %}</a></li>
  </ul>
</div>

