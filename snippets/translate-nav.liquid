{%- comment -%}
  Snippet: translate-nav.liquid
  Safely translates navigation strings, badges, category titles, and promo cards
  when the active locale is Arabic. Returns original string otherwise.
{%- endcomment -%}
{%- assign clean_text = text | strip -%}
{%- assign out = clean_text -%}
{%- if request.locale.iso_code == 'ar' or localization.language.iso_code == 'ar' -%}
