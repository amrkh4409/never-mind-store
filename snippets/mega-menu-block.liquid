    </div>
  {%- endif -%}

  <!-- Promotional Banner Card -->
  {%- if block.settings.show_promo -%}
    <div class="mega-menu__promo-col">
      <a href="{{ block.settings.promo_url | default: '/collections/all' }}" class="mega-menu__promo">
        <div class="mega-menu__promo-img-wrap">
          {%- if block.settings.promo_image != blank -%}
            <img src="{{ block.settings.promo_image | image_url: width: 600 }}" alt="{{ block.settings.promo_title | default: 'Drop' | escape }}" class="mega-menu__promo-img" loading="lazy">
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?auto=format&fit=crop&w=600&q=80" alt="Never Mind Drop" class="mega-menu__promo-img" loading="lazy">
          {%- endif -%}
          <div class="mega-menu__promo-overlay"></div>
        </div>
        <div class="mega-menu__promo-content">
          {%- if block.settings.promo_badge != blank -%}
            <span class="mega-menu__promo-tag">{{ block.settings.promo_badge }}</span>
          {%- endif -%}
          <h4 class="mega-menu__promo-title">{{ block.settings.promo_title | default: 'Never Mind Streetwear Drop' }}</h4>
          {%- if block.settings.promo_button_text != blank -%}
            <span class="mega-menu__promo-btn">
              {{ block.settings.promo_button_text }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          {%- endif -%}
        </div>
      </a>
    </div>
  {%- endif -%}
