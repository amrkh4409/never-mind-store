<!-- Mega Menu Block: Full Manual Control over Titles, Sub-links, and Promo Card -->
{%- if block != nil -%}
  <!-- Column 1 -->
  {%- if block.settings.col_1_title != blank or block.settings.col_1_menu != blank -%}
    <div class="mega-menu__col">
      <a href="{{ block.settings.col_1_url | default: '#' }}" class="mega-menu__heading">
        {{ block.settings.col_1_title | default: 'Column 1' }}
      </a>
      <ul class="mega-menu__list">
        {%- if block.settings.col_1_menu != blank and linklists[block.settings.col_1_menu].links.size > 0 -%}
          {%- for sub in linklists[block.settings.col_1_menu].links -%}
            <li class="mega-menu__item"><a href="{{ sub.url }}" class="mega-menu__link">{{ sub.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- if block.settings.col_1_link_1_title != blank -%}
            <li class="mega-menu__item"><a href="{{ block.settings.col_1_link_1_url | default: '#' }}" class="mega-menu__link">{{ block.settings.col_1_link_1_title }}</a></li>
          {%- endif -%}
          {%- if block.settings.col_1_link_2_title != blank -%}
            <li class="mega-menu__item"><a href="{{ block.settings.col_1_link_2_url | default: '#' }}" class="mega-menu__link">{{ block.settings.col_1_link_2_title }}</a></li>
          {%- endif -%}
          {%- if block.settings.col_1_link_3_title != blank -%}
            <li class="mega-menu__item"><a href="{{ block.settings.col_1_link_3_url | default: '#' }}" class="mega-menu__link">{{ block.settings.col_1_link_3_title }}</a></li>
          {%- endif -%}
          {%- if block.settings.col_1_link_4_title != blank -%}
            <li class="mega-menu__item"><a href="{{ block.settings.col_1_link_4_url | default: '#' }}" class="mega-menu__link">{{ block.settings.col_1_link_4_title }}</a></li>
          {%- endif -%}
          {%- if block.settings.col_1_link_5_title != blank -%}
            <li class="mega-menu__item"><a href="{{ block.settings.col_1_link_5_url | default: '#' }}" class="mega-menu__link">{{ block.settings.col_1_link_5_title }}</a></li>
          {%- endif -%}
          {%- if block.settings.col_1_link_6_title != blank -%}
            <li class="mega-menu__item"><a href="{{ block.settings.col_1_link_6_url | default: '#' }}" class="mega-menu__link" style="color: var(--color-primary); font-weight: 700;">{{ block.settings.col_1_link_6_title }}</a></li>
          {%- endif -%}
        {%- endif -%}
      </ul>
    </div>
  {%- endif -%}

