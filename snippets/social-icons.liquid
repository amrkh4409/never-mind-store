{%- comment -%}
  Renders social media icons with links from block, section, or global theme settings.
  Usage:
  {% render 'social-icons', block: block %}
{%- endcomment -%}

{%- liquid
  assign instagram = block.settings.social_instagram | default: block.settings.instagram | default: section.settings.social_instagram | default: settings.social_instagram
  assign facebook = block.settings.social_facebook | default: block.settings.facebook | default: section.settings.social_facebook | default: settings.social_facebook
  assign tiktok = block.settings.social_tiktok | default: block.settings.tiktok | default: section.settings.social_tiktok | default: settings.social_tiktok
  assign youtube = block.settings.social_youtube | default: block.settings.youtube | default: section.settings.social_youtube | default: settings.social_youtube
  assign twitter = block.settings.social_twitter | default: block.settings.twitter | default: section.settings.social_twitter | default: settings.social_twitter
  assign whatsapp = block.settings.social_whatsapp | default: block.settings.whatsapp | default: section.settings.social_whatsapp | default: settings.social_whatsapp
  assign pinterest = block.settings.social_pinterest | default: block.settings.pinterest | default: section.settings.social_pinterest | default: settings.social_pinterest

  # Process WhatsApp link if provided as a phone number
  if whatsapp != blank
    if whatsapp contains 'wa.me' or whatsapp contains 'http'
      assign whatsapp_url = whatsapp
    else
      assign clean_wa = whatsapp | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
      assign whatsapp_url = 'https://wa.me/' | append: clean_wa
    endif
  endif
-%}

<div class="footer-social-icons" style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
  {%- if instagram != blank -%}
    <a href="{{ instagram }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Instagram">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
    </a>
  {%- endif -%}

  {%- if facebook != blank -%}
    <a href="{{ facebook }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Facebook">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
      </svg>
    </a>
  {%- endif -%}

  {%- if tiktok != blank -%}
    <a href="{{ tiktok }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="TikTok">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.92 3.5 2.7 1.48-.1 2.71-1.09 3.1-2.52.2-.61.26-1.25.24-1.89l.05-14.86z"/>
      </svg>
    </a>
  {%- endif -%}

  {%- if youtube != blank -%}
    <a href="{{ youtube }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="YouTube">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
    </a>
  {%- endif -%}

  {%- if twitter != blank -%}
    <a href="{{ twitter }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="X (Twitter)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>
  {%- endif -%}

  {%- if whatsapp_url != blank -%}
    <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="WhatsApp">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.031 2C6.5 2 2 6.5 2 12.031c0 1.906.531 3.703 1.5 5.25L2 22l4.875-1.469c1.5 1 3.281 1.5 5.156 1.5 5.531 0 10.031-4.5 10.031-10.031C22.062 6.5 17.562 2 12.031 2zm5.906 14.281c-.25.703-1.25 1.312-1.781 1.391-.531.078-1.219.11-3.625-.859-2.906-1.188-4.781-4.141-4.938-4.344-.141-.188-1.203-1.609-1.203-3.078 0-1.469.766-2.188 1.047-2.484.281-.297.609-.375.812-.375.203 0 .406.002.594.016.188.016.453-.078.703.531.25.609.859 2.094.938 2.25.078.156.125.344.031.547-.094.203-.141.328-.281.5-.141.156-.312.359-.438.484-.141.141-.297.312-.125.609.172.297.766 1.266 1.641 2.047 1.125 1 2.078 1.312 2.375 1.453.297.141.469.125.641-.078.172-.203.734-.859.938-1.156.203-.297.406-.25.688-.141.281.109 1.781.844 2.094 1 .312.156.516.234.594.359.078.125.078.734-.172 1.437z"/>
      </svg>
    </a>
  {%- endif -%}

  {%- if pinterest != blank -%}
    <a href="{{ pinterest }}" target="_blank" rel="noopener noreferrer" class="footer-social-icon" aria-label="Pinterest">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0a12 12 0 0 0-4.37 23.18c-.07-.98-.13-2.49.03-3.56.14-.98.92-3.9 1.14-4.83.05-.2.13-.3.23-.28.16.03.62.27 1.03.27 1.35 0 2.36-1.24 2.36-3.1 0-2.22-1.74-3.87-4.18-3.87-2.88 0-4.57 2.16-4.57 4.39 0 1.04.4 2.16.9 2.76.1.12.11.23.08.35-.09.38-.3.1.22-.38 1.54-.05.21-.17.26-.39.16-1.44-.67-2.34-2.77-2.34-4.46 0-3.63 2.64-6.97 7.61-6.97 3.99 0 7.1 2.85 7.1 6.65 0 3.97-2.5 7.16-5.98 7.16-1.17 0-2.26-.6-2.64-1.32l-.72 2.74c-.26 1-.96 2.26-1.43 3.02A12 12 0 1 0 12 0z"/>
      </svg>
    </a>
  {%- endif -%}
</div>
